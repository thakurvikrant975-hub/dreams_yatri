generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model regions {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  country      String         @default("India")
  created_at   DateTime       @default(now())
  description  String?
  is_active    Boolean        @default(true)
  meta_desc    String?
  meta_title   String?
  updated_at   DateTime       @updatedAt
  cover_image  String?
  thumbnail    String?
  destinations destinations[]

  @@index([slug])
}

model destinations {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  country     String       @default("India")
  region_id   Int
  created_at  DateTime     @default(now())
  description String?
  is_active   Boolean      @default(true)
  meta_desc   String?
  meta_title  String?
  updated_at  DateTime     @updatedAt
  cover_image String?
  thumbnail   String?
  activities  activities[]
  bookings    Booking[]
  region      regions      @relation(fields: [region_id], references: [id])
  hotels      hotels[]
  packages    packages[]

  @@index([region_id])
  @@index([slug])
}

model categories {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  slug        String               @unique
  description String?
  meta_title  String?
  meta_desc   String?
  parent_id   Int?
  sort_order  Int                  @default(0)
  is_active   Boolean              @default(true)
  parent      categories?          @relation("CategoryTree", fields: [parent_id], references: [id])
  children    categories[]         @relation("CategoryTree")
  packages    package_categories[]

  @@index([parent_id])
  @@index([slug])
}

model tags {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  slug     String         @unique
  group    String?
  packages package_tags[]

  @@index([group])
  @@index([slug])
}

model packages {
  id              Int                       @id @default(autoincrement())
  title           String
  slug            String                    @unique
  thumbnail       String?
  cover_image     String?
  description     String?
  meta_title      String?
  meta_desc       String?
  destination_id  Int
  inclusions      String[]
  exclusions      String[]
  is_active       Boolean                   @default(true)
  created_at      DateTime                  @default(now())
  updated_at      DateTime                  @updatedAt
  activities      package_activities[]
  categories      package_categories[]
  durations       package_durations[]
  hotels          package_hotels[]
  images          package_images[]
  itineraries     package_itineraries[]
  policies        package_policy_map[]
  pricing         package_pricing[]
  stay_categories package_stay_categories[]
  tags            package_tags[]
  destination     destinations              @relation(fields: [destination_id], references: [id])

  @@index([destination_id, is_active])
  @@index([slug])
}

model policies {
  id         Int                  @id @default(autoincrement())
  type       PolicyType
  title      String
  is_active  Boolean              @default(true)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  points     String[]
  packages   package_policy_map[]

  @@index([type, is_active])
}

model package_policy_map {
  package_id Int
  policy_id  Int
  package    packages @relation(fields: [package_id], references: [id])
  policy     policies @relation(fields: [policy_id], references: [id])

  @@id([package_id, policy_id])
  @@index([policy_id])
}

model package_images {
  id          Int      @id @default(autoincrement())
  package_id  Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())
  package     packages @relation(fields: [package_id], references: [id])

  @@index([package_id])
}

model package_durations {
  id          Int                   @id @default(autoincrement())
  package_id  Int
  slug        String
  label       String
  days        Int
  nights      Int
  routes      Json
  meta_title  String?
  meta_desc   String?
  is_default  Boolean               @default(false)
  sort_order  Int                   @default(0)
  is_active   Boolean               @default(true)
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  package     packages              @relation(fields: [package_id], references: [id])
  itineraries package_itineraries[]
  pricing     package_pricing[]

  @@unique([package_id, slug])
  @@index([package_id, is_active])
}

model package_stay_categories {
  id                Int               @id @default(autoincrement())
  package_id        Int
  label             String
  description       String?
  min_duration_days Int?
  is_default        Boolean           @default(false)
  sort_order        Int               @default(0)
  is_active         Boolean           @default(true)
  slug              String
  hotels            package_hotels[]
  pricing           package_pricing[]
  package           packages          @relation(fields: [package_id], references: [id])

  @@unique([package_id, slug])
  @@index([package_id, is_active])
}

model package_pricing {
  id               Int                     @id @default(autoincrement())
  package_id       Int
  duration_id      Int
  route_index      Int
  price            Decimal                 @db.Decimal(10, 2)
  original_price   Decimal?                @db.Decimal(10, 2)
  is_active        Boolean                 @default(true)
  stay_category_id Int
  duration         package_durations       @relation(fields: [duration_id], references: [id])
  package          packages                @relation(fields: [package_id], references: [id])
  stay_category    package_stay_categories @relation(fields: [stay_category_id], references: [id])

  @@unique([package_id, duration_id, route_index, stay_category_id])
  @@index([package_id, duration_id, is_active])
}

model package_itineraries {
  id           Int               @id @default(autoincrement())
  package_id   Int
  duration_id  Int
  day          Int
  title        String
  description  String?
  activities   Json
  activity_ids Json?
  meals        Json?
  route_index  Int?
  hotel_days   Int?
  hotel_id     Int?
  duration     package_durations @relation(fields: [duration_id], references: [id])
  hotel        hotels?           @relation(fields: [hotel_id], references: [id])
  package      packages          @relation(fields: [package_id], references: [id])

  @@index([package_id, duration_id])
  @@index([hotel_id])
}

model package_tags {
  package_id Int
  tag_id     Int
  package    packages @relation(fields: [package_id], references: [id])
  tag        tags     @relation(fields: [tag_id], references: [id])

  @@id([package_id, tag_id])
  @@index([tag_id])
}

model package_categories {
  package_id  Int
  category_id Int
  category    categories @relation(fields: [category_id], references: [id])
  package     packages   @relation(fields: [package_id], references: [id])

  @@id([package_id, category_id])
  @@index([category_id])
}

model hotels {
  id               Int                      @id @default(autoincrement())
  name             String
  slug             String                   @unique
  description      String?
  meta_title       String?
  meta_desc        String?
  destination_id   Int
  address          String?
  latitude         Decimal?                 @db.Decimal(10, 8)
  longitude        Decimal?                 @db.Decimal(11, 8)
  star_rating      Int?
  category         String?
  amenities        Json?
  check_in_time    String?
  check_out_time   String?
  is_active        Boolean                  @default(true)
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  thumbnail        String?
  image_categories hotel_image_categories[]
  images           hotel_images[]
  room_pricing     hotel_room_pricing[]
  destination      destinations             @relation(fields: [destination_id], references: [id])
  packages         package_hotels[]
  itineraries      package_itineraries[]

  @@index([destination_id, is_active])
  @@index([slug])
}

model hotel_image_categories {
  id              Int                 @id @default(autoincrement())
  hotel_id        Int
  room_pricing_id Int?
  name            String
  is_required     Boolean             @default(false)
  is_system       Boolean             @default(false)
  sort_order      Int                 @default(0)
  hotel           hotels              @relation(fields: [hotel_id], references: [id])
  room_pricing    hotel_room_pricing? @relation(fields: [room_pricing_id], references: [id])
  images          hotel_images[]

  @@index([hotel_id])
  @@index([room_pricing_id])
}

model hotel_images {
  id          Int                    @id @default(autoincrement())
  hotel_id    Int
  category_id Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int                    @default(0)
  is_primary  Boolean                @default(false)
  created_at  DateTime               @default(now())
  category    hotel_image_categories @relation(fields: [category_id], references: [id])
  hotel       hotels                 @relation(fields: [hotel_id], references: [id])

  @@index([hotel_id])
  @@index([category_id])
}

model hotel_room_pricing {
  id                Int                      @id @default(autoincrement())
  hotel_id          Int
  room_type         String
  description       String?
  occupancy         Int                      @default(2)
  price_per_night   Decimal                  @db.Decimal(10, 2)
  original_price    Decimal?                 @db.Decimal(10, 2)
  season            String                   @default("all")
  amenities         Json?
  is_active         Boolean                  @default(true)
  sort_order        Int                      @default(0)
  margin_percentage Decimal                  @default(10) @db.Decimal(5, 2)
  image_categories  hotel_image_categories[]
  hotel             hotels                   @relation(fields: [hotel_id], references: [id])

  @@index([hotel_id, is_active])
  @@index([hotel_id, season])
}

model package_hotels {
  id               Int                     @id @default(autoincrement())
  package_id       Int
  hotel_id         Int
  stay_category_id Int
  night_number     Int?
  is_recommended   Boolean                 @default(false)
  hotel            hotels                  @relation(fields: [hotel_id], references: [id])
  package          packages                @relation(fields: [package_id], references: [id])
  stay_category    package_stay_categories @relation(fields: [stay_category_id], references: [id])

  @@index([package_id, stay_category_id])
  @@index([hotel_id])
}

model activities {
  id                Int                  @id @default(autoincrement())
  name              String
  slug              String               @unique
  description       String?
  meta_title        String?
  meta_desc         String?
  destination_id    Int
  duration_hours    Decimal?             @db.Decimal(4, 1)
  difficulty        String?
  category          String?
  price             Decimal?             @db.Decimal(10, 2)
  is_active         Boolean              @default(true)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  margin_percentage Decimal              @default(0) @db.Decimal(5, 2)
  max_persons       Int?
  min_persons       Int?
  original_price    Decimal?             @db.Decimal(10, 2)
  pricing_type      String?
  destination       destinations         @relation(fields: [destination_id], references: [id])
  images            activity_images[]
  packages          package_activities[]

  @@index([destination_id, is_active])
  @@index([category])
  @@index([slug])
}

model activity_images {
  id          Int        @id @default(autoincrement())
  activity_id Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int        @default(0)
  is_primary  Boolean    @default(false)
  created_at  DateTime   @default(now())
  activity    activities @relation(fields: [activity_id], references: [id])

  @@index([activity_id])
}

model package_activities {
  id          Int        @id @default(autoincrement())
  package_id  Int
  activity_id Int
  duration_id Int
  day_number  Int
  is_optional Boolean    @default(false)
  extra_price Decimal?   @db.Decimal(10, 2)
  activity    activities @relation(fields: [activity_id], references: [id])
  package     packages   @relation(fields: [package_id], references: [id])

  @@index([package_id, duration_id])
  @@index([activity_id])
}

model pricing_rules {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  value      Decimal  @db.Decimal(8, 2)
  applies_to String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([applies_to, is_active])
}

model images {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique
  folder        String
  original_url  String
  blur_url      String
  blur_base64   String
  original_key  String
  blur_key      String
  width         Int
  height        Int
  size_bytes    Int
  original_size Int
  aspect_ratio  String
  created_at    DateTime @default(now())
  thumbnail_key String
  thumbnail_url String

  @@index([folder])
}

model User {
  id                     String            @id @default(cuid())
  phone                  String?           @unique
  name                   String?
  email                  String?           @unique
  gender                 Gender?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          MaritalStatus?
  anniversary            DateTime?
  state                  String?
  city                   String?
  passportNumber         String?           @unique
  passportExpiryDate     DateTime?
  passportIssuingCountry String?
  panNumber              String?           @unique
  isProfileComplete      Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  emailVerified          DateTime?
  image                  String?
  country_code           String?
  role                   Role              @default(USER)
  status                 UserStatus        @default(ACTIVE)
  accounts               Account[]
  sessions               Session[]
  bookings               Booking[]
  payments               Payment[]
  travelPreference       TravelPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Otp {
  id        String    @id @default(cuid())
  phone     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  code      Int
  attempts  Int       @default(0)
  email     String?

  @@index([phone])
  @@index([email])
}

model MagicSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TravelPreference {
  id        String        @id @default(cuid())
  userId    String        @unique
  tripTypes TripType[]
  groupType GroupType?
  budget    BudgetTier?
  duration  TripDuration?
  months    TravelMonth[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  userId        String
  destinationId Int
  tripType      TripType
  startDate     DateTime
  endDate       DateTime
  duration      Int
  travellers    Int           @default(1)
  status        BookingStatus @default(UPCOMING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  currency      String        @default("INR")
  notes         String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  destination   destinations  @relation(fields: [destinationId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id               String         @id @default(cuid())
  bookingId        String
  userId           String
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  gateway          PaymentGateway
  method           PaymentMethod?
  status           PaymentStatus  @default(PENDING)
  gatewayOrderId   String?
  gatewayPaymentId String?        @unique
  gatewaySignature String?
  refundId         String?
  refundAmount     Decimal?       @db.Decimal(10, 2)
  refundedAt       DateTime?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  booking          Booking        @relation(fields: [bookingId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([gatewayOrderId])
  @@map("payments")
}

model RegionAll {
  id         Int            @id @default(autoincrement())
  name       String         @db.VarChar(255)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  countries  CountryAll[]
  subregions SubregionAll[]

  @@map("regions_all")
}

model SubregionAll {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  regionId  Int          @map("region_id")
  countries CountryAll[]
  region    RegionAll    @relation(fields: [regionId], references: [id])

  @@index([regionId])
  @@map("subregions_all")
}

model CountryAll {
  id                Int           @id @default(autoincrement())
  name              String        @db.VarChar(255)
  iso2              String?       @db.Char(2)
  phonecode         String?       @db.VarChar(255)
  capital           String?       @db.VarChar(255)
  currency          String?       @db.VarChar(255)
  currencyName      String?       @map("currency_name") @db.VarChar(255)
  nationality       String?       @db.VarChar(255)
  latitude          Decimal?      @db.Decimal(10, 8)
  longitude         Decimal?      @db.Decimal(11, 8)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  regionId          Int?          @map("region_id")
  subregionId       Int?          @map("subregion_id")
  cities            CityAll[]
  regionRelation    RegionAll?    @relation(fields: [regionId], references: [id])
  subregionRelation SubregionAll? @relation(fields: [subregionId], references: [id])
  states            StateAll[]

  @@index([regionId])
  @@index([subregionId])
  @@map("countries_all")
}

model StateAll {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  countryCode String     @map("country_code") @db.Char(2)
  latitude    Decimal?   @db.Decimal(10, 8)
  longitude   Decimal?   @db.Decimal(11, 8)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  countryId   Int        @map("country_id")
  cities      CityAll[]
  country     CountryAll @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@map("states_all")
}

model CityAll {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(255)
  stateCode   String     @map("state_code") @db.VarChar(255)
  countryCode String     @map("country_code") @db.Char(2)
  latitude    Decimal    @db.Decimal(10, 8)
  longitude   Decimal    @db.Decimal(11, 8)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  stateId     Int        @map("state_id")
  countryId   Int        @map("country_id")
  country     CountryAll @relation(fields: [countryId], references: [id])
  state       StateAll   @relation(fields: [stateId], references: [id])

  @@index([stateId])
  @@index([countryId])
  @@map("cities_all")
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]

  @@map("departments")
}

model TeamRole {
  id          String       @id @default(cuid())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(500)
  permissions Json         @default("[]")   // ← changed from String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]
  @@map("team_roles")
}

model TeamMember {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(255)
  email        String      @unique
  password     String?
  departmentId String?
  teamRoleId   String?
  isActive     Boolean     @default(true)
  joiningDate  DateTime?
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  teamRole     TeamRole?   @relation(fields: [teamRoleId], references: [id])

  @@index([email])
  @@index([departmentId])
  @@index([teamRoleId])
  @@map("team_members")
}

model ActivityLog {
  id              String      @id @default(cuid())
  userId          String?
  userEmail       String?
  userName        String?
  userRole        String?
  userDesignation String?
  action          LogAction
  entity          String
  entityId        String?
  entitySlug      String?
  previousData    Json?
  newData         Json?
  metadata        Json?
  status          LogStatus   @default(SUCCESS)
  errorMessage    String?
  statusCode      Int?
  severity        LogSeverity @default(LOW)
  isSuspicious    Boolean     @default(false)
  flagReason      String?
  ipAddress       String?
  userAgent       String?
  referer         String?
  requestMethod   String?
  requestPath     String?
  sessionId       String?
  requestId       String?
  country         String?
  region          String?
  city            String?
  actionAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  description     String?

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([status])
  @@index([severity])
  @@index([isSuspicious])
  @@index([actionAt])
  @@index([ipAddress])
  @@map("activity_logs")
}

model PackageQuery {
  id                String           @id @default(cuid())
  name              String
  email             String?
  phone             String
  countryCode       String  @default("IN")
  message           String?
  packageName       String?
  destination       String?
  travelDate        DateTime?
  groupSize         Int?
  source            QuerySource      @default(WEBSITE_FORM)
  gclid             String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  pageUrl           String?
  status            QueryStatus      @default(SUBMITTED)
  verified          Boolean          @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  rejectionReasonId String?
  rejectionNote     String?
  callAttempts      Int              @default(0)
  lastAttemptAt     DateTime?
  nextFollowUpAt    DateTime?
  assignedTo        String?
  assignedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  rejectionReason   RejectionReason? @relation(fields: [rejectionReasonId], references: [id])
  notes             QueryNote[]
  timeline          QueryTimeline[]

  leadProfileId String?
  leadProfile   LeadProfile? @relation(fields: [leadProfileId], references: [id])

  @@index([status])
  @@index([verified])
  @@index([destination])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("package_queries")
}

model RejectionReason {
  id          String         @id @default(cuid())
  label       String
  description String?
  isSystem    Boolean        @default(false)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  queries     PackageQuery[]

  @@map("rejection_reasons")
}

model QueryNote {
  id        String       @id @default(cuid())
  queryId   String
  authorId  String
  content   String
  createdAt DateTime     @default(now())
  query     PackageQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@map("query_notes")
}

model QueryTimeline {
  id        String       @id @default(cuid())
  queryId   String
  actorId   String?
  actorName String?
  event     String
  meta      Json?
  createdAt DateTime     @default(now())
  query     PackageQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@map("query_timeline")
}

model LeadProfile {
  id          String         @id @default(cuid())
  phone       String         @unique  // normalized e.g. "+919876543210"
  name        String                  // from latest query
  email       String?
  totalQueries Int           @default(0)
  lastSeenAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  queries     PackageQuery[]

  @@map("lead_profiles")
}

