generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BookingMeal {
  id             String         @id @default(cuid())
  bookingId      String
  bookingHotelId String
  dayNumber      Int
  mealType       MealType
  foodPreference FoodPreference
  ratePerPerson  Decimal        @db.Decimal(10, 2)
  travellers     Int
  totalCost      Decimal        @db.Decimal(10, 2)
  bookingHotel   BookingHotel   @relation(fields: [bookingHotelId], references: [id], onDelete: Cascade)
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([bookingHotelId])
  @@map("booking_meals")
}

model pricing_rules {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  value      Decimal  @db.Decimal(8, 2)
  applies_to String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([applies_to, is_active])
}

model User {
  id                     String            @id @default(cuid())
  phone                  String?           @unique
  name                   String?
  email                  String?           @unique
  gender                 Gender?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          MaritalStatus?
  anniversary            DateTime?
  state                  String?
  city                   String?
  passportNumber         String?           @unique
  passportExpiryDate     DateTime?
  passportIssuingCountry String?
  panNumber              String?           @unique
  isProfileComplete      Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  emailVerified          DateTime?
  image                  String?
  country_code           String?
  role                   Role              @default(USER)
  status                 UserStatus        @default(ACTIVE)
  accounts               Account[]
  sessions               Session[]
  bookings               Booking[]
  payments               Payment[]
  travelPreference       TravelPreference?
  blogPosts              blog_posts[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Otp {
  id        String    @id @default(cuid())
  phone     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  code      Int
  attempts  Int       @default(0)
  email     String?

  @@index([phone])
  @@index([email])
}

model MagicSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TravelPreference {
  id        String        @id @default(cuid())
  userId    String        @unique
  tripTypes TripType[]
  groupType GroupType?
  budget    BudgetTier?
  duration  TripDuration?
  months    TravelMonth[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

model Booking {
  id                      String                @id @default(cuid())
  bookingNumber           String                @unique
  userId                  String
  packageId               Int?
  destinationId           Int
  tripType                TripType
  startDate               DateTime
  endDate                 DateTime
  duration                Int
  travellers              Int                   @default(1)
  status                  BookingStatus         @default(PENDING_REVIEW)
  cabType                 CabType               @default(INNOVA)
  roomSharingType         RoomSharingType       @default(SHARED)
  mealPlan                MealPlan              @default(MAP)
  hotelCost               Decimal               @default(0) @db.Decimal(10, 2)
  cabCost                 Decimal               @default(0) @db.Decimal(10, 2)
  mealCost                Decimal               @default(0) @db.Decimal(10, 2)
  subtotal                Decimal               @default(0) @db.Decimal(10, 2)
  marginAmount            Decimal               @default(0) @db.Decimal(10, 2)
  gstAmount               Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount             Decimal               @db.Decimal(10, 2)
  paidAmount              Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount_paise       Int                   @default(0) // paise — charge source of truth
  advanceAmount_paise     Int                   @default(0)
  balanceAmount_paise     Int                   @default(0)
  currency                String                @default("INR")
  notes                   String?
  cancelledAt             DateTime?
  cancelReason            String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  currentDepartmentId     String?
  currentAssigneeId       String?
  hotelAssigneeId         String?
  hotelConfirmedAt        DateTime?
  hotelNotes              String?
  cabAssigneeId           String?
  cabConfirmedAt          DateTime?
  cabNotes                String?
  opsAssigneeId           String?
  opsReviewedAt           DateTime?
  rejectionReason         String?
  modificationNote        String?
  modificationRequestedBy String?
  paymentStatus           PaymentStatus         @default(PENDING)
  advancePaidAmount       Decimal               @default(0) @db.Decimal(10, 2)
  balanceDueAmount        Decimal               @default(0) @db.Decimal(10, 2)
  balanceDueDate          DateTime?
  quoteId                 String?               @unique // loose ref to package_quote.id (one booking per quote)
  quoteInputsHash         String?               // audit trail back to the quote's locked inputs
  priceSnapshot           Json?                 // frozen FullPricingBreakdown copied from the quote
  paymentPlan             PaymentPlan?          // FULL vs DEPOSIT (resolved at booking time)
  sourceQueryId           String?               @unique
  convertedAt             DateTime?
  salesAgentId            String?
  salesAgentName          String?
  referredBy              String?
  referralSource          ReferralSource?
  opsAgentName            String?
  hotelAgentName          String?
  cabAgentName            String?
  confirmationEmailSentAt DateTime?
  confirmationEmailTo     String?
  cabBookings             BookingCab[]
  hotelBookings           BookingHotel[]
  bookingMeals            BookingMeal[]
  timeline                BookingTimeline[]
  cabAssignee             TeamMember?           @relation("BookingCabAssignee", fields: [cabAssigneeId], references: [id])
  currentAssignee         TeamMember?           @relation("BookingCurrentAssignee", fields: [currentAssigneeId], references: [id])
  currentDepartment       Department?           @relation("BookingCurrentDept", fields: [currentDepartmentId], references: [id])
  destination             destinations          @relation(fields: [destinationId], references: [id])
  hotelAssignee           TeamMember?           @relation("BookingHotelAssignee", fields: [hotelAssigneeId], references: [id])
  opsAssignee             TeamMember?           @relation("BookingOpsAssignee", fields: [opsAssigneeId], references: [id])
  package                 packages?             @relation(fields: [packageId], references: [id])
  sourceQuery             package_queries?      @relation(fields: [sourceQueryId], references: [id])
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageHotels           PackageBookingHotel[]
  payments                Payment[]
  documents               TripDocument[]

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@map("bookings")
}

model TripDocument {
  id         String       @id @default(cuid())
  bookingId  String
  type       DocumentType
  fileUrl    String
  uploadedBy String
  uploadedAt DateTime     @default(now())
  booking    Booking      @relation(fields: [bookingId], references: [id])

  @@map("trip_documents")
}

model BookingHotel {
  id            String        @id @default(cuid())
  bookingId     String
  dayNumber     Int
  cityName      String
  checkInDate   DateTime
  checkOutDate  DateTime
  hotelId       Int
  roomType      String
  roomsCount    Int
  ratePerRoom   Decimal       @db.Decimal(10, 2)
  totalCost     Decimal       @db.Decimal(10, 2)
  isConfirmed   Boolean       @default(false)
  confirmedAt   DateTime?
  confirmedById String?
  notes         String?
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedBy   TeamMember?   @relation(fields: [confirmedById], references: [id])
  hotel         hotels        @relation(fields: [hotelId], references: [id])
  meals         BookingMeal[]

  @@unique([bookingId, dayNumber])
  @@index([bookingId])
  @@index([hotelId])
  @@map("booking_hotels")
}

model BookingCab {
  id            String      @id @default(cuid())
  bookingId     String
  legNumber     Int
  fromLocation  String
  toLocation    String
  transferDate  DateTime
  cabType       CabType
  cabCount      Int         @default(1)
  capacity      Int
  ratePerCab    Decimal     @db.Decimal(10, 2)
  totalCost     Decimal     @db.Decimal(10, 2)
  isConfirmed   Boolean     @default(false)
  confirmedAt   DateTime?
  confirmedById String?
  driverName    String?
  driverPhone   String?
  vehicleNumber String?
  notes         String?
  booking       Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedBy   TeamMember? @relation(fields: [confirmedById], references: [id])

  @@unique([bookingId, legNumber])
  @@index([bookingId])
  @@map("booking_cabs")
}

model PackageBookingHotel {
  id           String   @id @default(cuid())
  bookingId    String
  hotelId      Int
  stayType     String?
  checkingDate DateTime
  checkoutDate DateTime
  pax          Int      @default(1)
  rooms        Int      @default(1)
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel        hotels   @relation(fields: [hotelId], references: [id])

  @@index([bookingId])
  @@map("package_booking_hotel")
}

model BookingTimeline {
  id              String         @id @default(cuid())
  bookingId       String
  action          TimelineAction
  fromStatus      BookingStatus?
  toStatus        BookingStatus?
  note            String?
  performedById   String
  performedByName String
  departmentId    String?
  createdAt       DateTime       @default(now())
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  department      Department?    @relation("TimelineDepartment", fields: [departmentId], references: [id])
  performedBy     TeamMember     @relation("TimelinePerformedBy", fields: [performedById], references: [id])

  @@index([bookingId])
  @@index([performedById])
  @@map("booking_timeline")
}

model Payment {
  id               String         @id @default(cuid())
  bookingId        String
  userId           String
  amount           Decimal        @db.Decimal(10, 2)
  amount_paise     Int            @default(0) // integer minor units — charge source of truth
  currency         String         @default("INR")
  gateway          PaymentGateway
  method           PaymentMethod?
  status           PaymentStatus  @default(PENDING)
  gatewayOrderId   String?
  gatewayPaymentId String?        @unique
  gatewaySignature String?
  refundId         String?
  refundAmount     Decimal?       @db.Decimal(10, 2)
  refundedAt       DateTime?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  booking          Booking        @relation(fields: [bookingId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Location {
  id               BigInt            @id @default(autoincrement())
  parent_id        BigInt?
  type             LocationType
  name             String
  official_name    String?
  slug             String            @unique
  short_code       String?
  iso_code         String?
  latitude         Decimal?          @db.Decimal(10, 7)
  longitude        Decimal?          @db.Decimal(10, 7)
  elevation_meters Int?
  timezone         String?
  population       Int?
  seo_title        String?
  seo_description  String?
  description      String?
  hero_image       String?
  is_featured      Boolean           @default(false)
  is_popular       Boolean           @default(false)
  is_searchable    Boolean           @default(true)
  is_active        Boolean           @default(true)
  country_id       BigInt?
  state_id         BigInt?
  city_id          BigInt?
  geonames_id      Int?
  osm_id           String?
  mapbox_id        String?
  metadata         Json?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  activities       activities[]
  hotels           hotels[]
  city             Location?         @relation("CityRelation", fields: [city_id], references: [id])
  city_children    Location[]        @relation("CityRelation")
  country          Location?         @relation("CountryRelation", fields: [country_id], references: [id])
  country_children Location[]        @relation("CountryRelation")
  parent           Location?         @relation("LocationHierarchy", fields: [parent_id], references: [id])
  children         Location[]        @relation("LocationHierarchy")
  state            Location?         @relation("StateRelation", fields: [state_id], references: [id])
  state_children   Location[]        @relation("StateRelation")
  route_stops      route_stops[]
  drop_routes      transfer_routes[] @relation("drop_routes")
  pickup_routes    transfer_routes[] @relation("pickup_routes")

  @@index([type])
  @@index([parent_id])
  @@index([country_id])
  @@index([state_id])
  @@index([city_id])
  @@index([latitude, longitude])
  @@index([is_active])
  @@index([is_searchable])
  @@index([name])
  @@index([slug])
  @@map("locations")
}

model Department {
  id              String            @id @default(cuid())
  name            String            @unique @db.VarChar(100)
  description     String?           @db.VarChar(500)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  timelineEntries BookingTimeline[] @relation("TimelineDepartment")
  currentBookings Booking[]         @relation("BookingCurrentDept")
  members         TeamMember[]

  @@map("departments")
}

model TeamRole {
  id          String       @id @default(cuid())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(500)
  permissions Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]

  @@map("team_roles")
}

model TeamMember {
  id                     String            @id @default(cuid())
  name                   String            @db.VarChar(255)
  email                  String            @unique
  password               String?
  departmentId           String?
  teamRoleId             String?
  isActive               Boolean           @default(true)
  joiningDate            DateTime?
  lastLoginAt            DateTime?
  createdById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  aadhaarFileKey         String?
  aadhaarFileUrl         String?
  aadhaarNumber          String?           @db.VarChar(12)
  alternativeMobile      String?           @db.VarChar(15)
  designation            String?           @db.VarChar(255)
  employeeId             String            @unique
  fatherMobile           String?           @db.VarChar(15)
  fatherName             String?           @db.VarChar(255)
  motherMobile           String?           @db.VarChar(15)
  motherName             String?           @db.VarChar(255)
  panFileKey             String?
  panFileUrl             String?
  panNumber              String?           @db.VarChar(10)
  personalEmail          String?
  personalMobile         String?           @db.VarChar(15)
  profilePicKey          String?
  profilePicUrl          String?
  confirmedCabBookings   BookingCab[]
  confirmedHotelBookings BookingHotel[]
  timelineEntries        BookingTimeline[] @relation("TimelinePerformedBy")
  cabBookings            Booking[]         @relation("BookingCabAssignee")
  currentBookings        Booking[]         @relation("BookingCurrentAssignee")
  hotelBookings          Booking[]         @relation("BookingHotelAssignee")
  opsBookings            Booking[]         @relation("BookingOpsAssignee")
  department             Department?       @relation(fields: [departmentId], references: [id])
  teamRole               TeamRole?         @relation(fields: [teamRoleId], references: [id])

  @@index([email])
  @@index([employeeId])
  @@index([departmentId])
  @@index([teamRoleId])
  @@map("team_members")
}

model ActivityLog {
  id              String      @id @default(cuid())
  userId          String?
  userEmail       String?
  userName        String?
  userRole        String?
  userDesignation String?
  action          LogAction
  entity          String
  entityId        String?
  entitySlug      String?
  previousData    Json?
  newData         Json?
  metadata        Json?
  status          LogStatus   @default(SUCCESS)
  errorMessage    String?
  statusCode      Int?
  severity        LogSeverity @default(LOW)
  isSuspicious    Boolean     @default(false)
  flagReason      String?
  ipAddress       String?
  userAgent       String?
  referer         String?
  requestMethod   String?
  requestPath     String?
  sessionId       String?
  requestId       String?
  country         String?
  region          String?
  city            String?
  actionAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  description     String?

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([status])
  @@index([severity])
  @@index([isSuspicious])
  @@index([actionAt])
  @@index([ipAddress])
  @@map("activity_logs")
}

model RejectionReason {
  id              String            @id @default(cuid())
  label           String
  description     String?
  isSystem        Boolean           @default(false)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package_queries package_queries[]

  @@map("rejection_reasons")
}

model QueryNote {
  id        String          @id @default(cuid())
  queryId   String
  authorId  String
  content   String
  createdAt DateTime        @default(now())
  query     package_queries @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@map("query_notes")
}

model QueryTimeline {
  id        String          @id @default(cuid())
  queryId   String
  actorId   String?
  actorName String?
  event     String
  meta      Json?
  createdAt DateTime        @default(now())
  query     package_queries @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@map("query_timeline")
}

model LeadProfile {
  id              String            @id @default(cuid())
  phone           String            @unique
  name            String
  email           String?
  totalQueries    Int               @default(0)
  lastSeenAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package_queries package_queries[]

  @@map("lead_profiles")
}

model custom_regions {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  country      String         @default("India")
  created_at   DateTime       @default(now())
  description  String?
  is_active    Boolean        @default(true)
  meta_desc    String?
  meta_title   String?
  updated_at   DateTime       @updatedAt
  cover_image  String?
  thumbnail    String?
  created_by   String?
  deleted_at   DateTime?
  deleted_by   String?
  is_deleted   Boolean        @default(false)
  updated_by   String?
  destinations destinations[]

  @@index([slug])
  @@index([is_deleted])
  @@map("regions")
}

model destinations {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  country     String         @default("India")
  region_id   Int
  created_at  DateTime       @default(now())
  description String?
  is_active   Boolean        @default(true)
  meta_desc   String?
  meta_title  String?
  updated_at  DateTime       @updatedAt
  cover_image String?
  thumbnail   String?
  latitude    Decimal?       @db.Decimal(10, 8)
  longitude   Decimal?       @db.Decimal(11, 8)
  place_id    String?
  location_id String?
  created_by  String?
  deleted_at  DateTime?
  deleted_by  String?
  is_deleted  Boolean        @default(false)
  updated_by  String?
  activities  activities[]
  bookings    Booking[]
  cabPricings cab_pricing[]
  region      custom_regions @relation(fields: [region_id], references: [id])
  hotels      hotels[]
  packages    packages[]

  @@index([region_id])
  @@index([slug])
  @@index([is_deleted])
}

model categories {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  slug        String               @unique
  description String?
  meta_title  String?
  meta_desc   String?
  parent_id   Int?
  sort_order  Int                  @default(0)
  is_active   Boolean              @default(true)
  parent      categories?          @relation("CategoryTree", fields: [parent_id], references: [id])
  children    categories[]         @relation("CategoryTree")
  packages    package_categories[]

  @@index([parent_id])
  @@index([slug])
}

model tags {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  slug     String         @unique
  group    String?
  packages package_tags[]

  @@index([group])
  @@index([slug])
}

model policies {
  id         Int                  @id @default(autoincrement())
  type       PolicyType
  title      String
  is_active  Boolean              @default(true)
  sort_order Int                  @default(0)
  created_at DateTime             @default(now())
  updated_at DateTime             @updatedAt
  points     String[]
  packages   package_policy_map[]

  @@index([type, is_active])
}

model hotels {
  id               Int                      @id @default(autoincrement())
  name             String
  slug             String                   @unique
  description      String?
  meta_title       String?
  meta_desc        String?
  destination_id   Int
  address          String?
  category         String?
  stay_type        String?
  check_in_time    String?
  check_out_time   String?
  is_active        Boolean                  @default(true)
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt
  thumbnail        String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  business_phone   String?
  business_email   String?
  location_id      BigInt?
  bookingHotels    BookingHotel[]
  childPolicies    hotel_child_policies[]
  image_categories hotel_image_categories[]
  images           hotel_images[]
  room_pricing     hotel_room_pricing[]
  meal_pricing     hotel_meal_pricing[]
  hotelRooms       hotel_rooms[]
  destination      destinations             @relation(fields: [destination_id], references: [id])
  location         Location?                @relation(fields: [location_id], references: [id])
  packageBookings  PackageBookingHotel[]

  @@index([destination_id, is_active])
  @@index([location_id])
  @@index([slug])
}

model hotel_image_categories {
  id              Int                 @id @default(autoincrement())
  hotel_id        Int
  room_pricing_id Int?
  name            String
  is_required     Boolean             @default(false)
  is_system       Boolean             @default(false)
  sort_order      Int                 @default(0)
  hotel           hotels              @relation(fields: [hotel_id], references: [id])
  room_pricing    hotel_room_pricing? @relation(fields: [room_pricing_id], references: [id])
  images          hotel_images[]

  @@index([hotel_id])
  @@index([room_pricing_id])
}

model hotel_images {
  id          Int                    @id @default(autoincrement())
  hotel_id    Int
  category_id Int
  thumbnail   String?
  alt         String?
  sort_order  Int                    @default(0)
  is_primary  Boolean                @default(false)
  created_at  DateTime               @default(now())
  url         String?
  category    hotel_image_categories @relation(fields: [category_id], references: [id])
  hotel       hotels                 @relation(fields: [hotel_id], references: [id])

  @@index([hotel_id])
  @@index([category_id])
}

model hotel_rooms {
  id                 Int                  @id @default(autoincrement())
  hotel_id           Int
  name               String
  slug               String
  area_sqft          Int?
  bed_type           String?
  view_type          String?
  max_occupancy      Int                  @default(2)
  extra_bed_capacity Int                  @default(1)
  amenities          Json?
  features           Json?
  bathroom           Json?
  facilities         Json?
  description        String?
  is_active          Boolean              @default(true)
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  images             hotel_room_images[]
  pricing            hotel_room_pricing[]
