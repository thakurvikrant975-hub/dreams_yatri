}

model permits {
  id                Int                    @id @default(autoincrement())
  name              String
  category          PermitCategory         @default(OTHER)
  location_id       BigInt?
  issuing_authority String?
  // Legacy flat rates — superseded by vehicleRates (per-vehicle, per-km) below,
  // kept only so the older catalog-package pricing engine (which still reads
  // these two columns directly) doesn't break; the admin Permits page no
  // longer collects them and always writes 0/null going forward.
  price_per_vehicle Decimal                @default(0) @db.Decimal(10, 2)
  price_per_person  Decimal?               @db.Decimal(10, 2)
  validity_type     PermitValidityType     @default(SINGLE_TRIP)
  validity_days     Int?
  custom_category   String?
  notes             String?
  is_active         Boolean                @default(true)
  created_by        String?
  updated_by        String?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  location          Location?              @relation(fields: [location_id], references: [id], onDelete: SetNull)
  vehicleRates      permit_vehicle_rates[]
  packagePermits    package_permits[]

  @@index([location_id])
  @@index([category])
  @@index([is_active])
  @@map("permits")
}

// Per-vehicle permit rate — a mountain pass like Rohtang charges a different
// flat amount per vehicle type (SUV vs Sedan vs Bus, etc.); an optional
// per-km rate covers permits that instead scale with distance travelled.
model permit_vehicle_rates {
  id                Int      @id @default(autoincrement())
  permit_id         Int
  vehicle_id        Int
  price_per_vehicle Decimal  @db.Decimal(10, 2)
  price_per_km      Decimal? @db.Decimal(10, 2)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  permit            permits  @relation(fields: [permit_id], references: [id], onDelete: Cascade)
  vehicle           vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@unique([permit_id, vehicle_id])
  @@index([permit_id])
  @@index([vehicle_id])
  @@map("permit_vehicle_rates")
}

// Generic key-value store for small, global toggles (e.g. "is auto-assign on?")
// that don't warrant their own dedicated table.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_settings")
}

/// Costing's per-element findings on a package under review.
///
/// A rejection used to be one note on the whole package, which is fine for
/// "priced too low" and useless for "day 3's cab rate is wrong and the Goa
/// hotel is the wrong room type" — the exec got a paragraph and had to work out
/// which elements it meant. Each finding is pinned to the thing it is about, so
/// it can render on that element in the document and be resolved on its own.
///
/// This is what makes "partially correct, reject the rest" expressible: costing
/// fixes what it can, leaves the rest OPEN, and rejects. The open notes ARE the
/// rejection detail.
model package_review_notes {
  id              String           @id @default(cuid())
  customPackageId String
  /// What the note is about. DAY/PACKAGE carry no index; PRICING pins to the
  /// costing breakdown rather than to document content.
  targetKind      ReviewTargetKind
  /// 1-based day number for anything that lives on a day. Null for PACKAGE and
  /// for PRICING notes about the package total.
  day             Int?
  /// Position within the day's list (activity n, ticket n, add-on n). Null when
  /// the day has only one of the thing — a day has one stay and one transfer.
  index           Int?
  severity        ReviewSeverity
  status          ReviewNoteStatus @default(OPEN)
  message         String
  createdById     String?
  createdByName   String?
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedByName  String?
  package         custom_packages  @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

  /// The queue's "N issues open" badge and the document's per-element lookup
  /// both read by package + status, so they share one index.
  @@index([customPackageId, status])
  @@map("package_review_notes")
}

enum ReviewTargetKind {
  STAY
  TRANSPORT
  ACTIVITY
  MEAL
  TICKET
  ADDON
  DAY
  PRICING
  PACKAGE
}

enum ReviewSeverity {
  /// Blocks approval — the exec has to act on it.
  ERROR
  /// Worth improving, does not block.
  SUGGESTION
}

enum ReviewNoteStatus {
  OPEN
  RESOLVED
}
