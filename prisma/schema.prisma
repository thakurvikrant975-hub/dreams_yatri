model hotel_room_pricing_season {
  id                      Int                                   @id @default(autoincrement())
  pricing_id              Int
  season_name             String
  valid_from              DateTime
  valid_to                DateTime
  price_per_night         Decimal                               @db.Decimal(10, 2)
  original_price          Decimal?                              @db.Decimal(10, 2)
  is_active               Boolean                               @default(true)
  sort_order              Int                                   @default(0)
  created_at              DateTime                              @default(now())
  updated_at              DateTime                              @updatedAt
  extra_bed_rate          Decimal?                              @db.Decimal(10, 2)
  weekend_price_per_night Decimal?                              @db.Decimal(10, 2)
  // Per-season child rate — the parent hotel_room_pricing has this but a
  // season previously couldn't override it for its own date range.
  extra_child_rate        Decimal?                              @db.Decimal(10, 2)
  weekend_extra_bed_rate  Decimal?                              @db.Decimal(10, 2)
  color                   String?
  occupancy_prices        hotel_room_pricing_season_occupancy[]
  pricing                 hotel_room_pricing                    @relation(fields: [pricing_id], references: [id], onDelete: Cascade)

  @@index([pricing_id])
  // Powers the Expiring Rates dashboard page: every query there filters
  // is_active=true and a valid_to range (and sorts by valid_to) — without
  // this, that page falls back to a full table scan as seasons grow.
  @@index([is_active, valid_to])
  @@index([season_name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("hotel_room_pricing_seasons")
}

model hotel_room_pricing_season_occupancy {
  id                      Int                       @id @default(autoincrement())
  season_id               Int
  occupancy               Int
  price_per_night         Decimal                   @db.Decimal(10, 2)
  original_price          Decimal?                  @db.Decimal(10, 2)
  weekend_price_per_night Decimal?                  @db.Decimal(10, 2)
  season                  hotel_room_pricing_season @relation(fields: [season_id], references: [id], onDelete: Cascade)

