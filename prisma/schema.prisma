model custom_packages {
  id                      String                   @id @default(cuid())
  /**
   * Nullable + non-unique — a query can have multiple packages built for it
   * (e.g. two different budget options sent to the same client), and a
   * package can exist with no linked query at all ("blank" packages, built
   * ahead of a lead so an exec can reuse/adapt one on the fly).
   */
  queryId                 String?
  title                   String
  description             String?
  coverImage              String?
  /**
   * Vertical focal point for the cover image's object-position (0 = top,
   * 50 = center, 100 = bottom) — lets the exec re-center an image that
   * object-cover crops awkwardly, without re-uploading/re-cropping it.
   */
  coverImagePosition      Float                    @default(50)
  destination             String
  startingPoint           String?
  totalDays               Int
  totalNights             Int
  travelDate              DateTime?
  adults                  Int                      @default(1)
  children                Int                      @default(0)
  infants                 Int                      @default(0)
  /**
   * Per-traveller ages, entered by the sales exec on the Package tab —
   * costing sometimes needs the actual age (not just the count) to check
   * hotel child-policy brackets (free-under-X, extra-bed-under-Y) against
   * what's actually been priced in. Index-aligned with the count above but
   * not enforced to always match its length — a count change resizes the
   * array client-side, this is just whatever was last saved.
   */
  childrenAges            Int[]                    @default([])
  infantAges              Int[]                    @default([])
  pricePerPerson          Float?
  totalPrice              Float?
  currency                String                   @default("INR")
  marginPercentage        Float                    @default(25)
  gstPercentage           Float                    @default(5)
  /**
   * Costing-team correction, set during pre-send review (verify-packages'
   * updatePackagePricing) when the live-computed hotel/cab subtotal is
   * wrong — e.g. the exec picked the wrong room rate. Null means "use the
   * live computed subtotal as-is". Checked by sendPackageToClient at the
   * exec's send time so a correction actually reaches the locked price
   * instead of being silently recomputed away. Reset to null every time the
   * exec marks the package ready again, since a re-submitted itinerary may
   * have genuinely different rooms/cabs the old override no longer applies to.
   */
  hotelSubtotalOverride   Float?
  cabSubtotalOverride     Float?
  inclusions              String[]
  exclusions              String[]
  /**
   * Costing-team vetoes applied during pre-send review (verify-packages) —
   * exact-string removals from the merged inclusions/exclusions list (the
   * live itinerary_settings standard lists above + this package's own
   * extraPolicyItems additions). Kept separate from the two fields above
   * (which just mirror the global defaults on every builder save, see
   * saveCustomPackage) so a reviewer can drop a line that doesn't apply to
   * THIS package without touching the company-wide defaults. Never touched
   * by saveCustomPackage — set only from updatePackageInclusionsExclusions
   * (verify-packages/actions.ts), so an exec's builder save can't clobber a
   * costing edit made while the package sits in READY review.
   */
  removedInclusions       String[]                 @default([])
  removedExclusions       String[]                 @default([])
  termsNotes              String?
  /**
   * Short, removable bullet points — seeded with company-wide defaults the
   * exec can trim/extend per package, distinct from the free-text termsNotes
   * above (kept as a separate general-notes field).
   */
  termsConditions         String[]
  paymentPolicy           String[]
  amendmentPolicy         String[]
  /**
   * "Benefits of Travelling With Us" — marketing bullets shown on the
   * client-facing document/page, same removable-default pattern as above.
   */
  travelBenefits          String[]
  /**
   * Mirrors itinerary_settings.customPolicySections at save time — admin-
   * defined extra policy blocks (`{ id, title, items }[]`) beyond the six
   * fixed lists above.
   */
  customPolicySections    Json?
  /**
   * Per-package additions to the six standard lists above (inclusions,
   * exclusions, termsConditions, paymentPolicy, amendmentPolicy,
   * travelBenefits) — lets a sales exec add something specific to this
   * client's package (e.g. "Complimentary airport pickup") without being
   * able to edit or remove the standard items, which stay admin-managed
   * only via itinerary_settings. Shape: `{ inclusions: string[], ... }`,
   * one key per standard list, each defaulting to an empty array.
   */
  extraPolicyItems        Json                     @default("{}")
  status                  CustomPackageStatus      @default(DRAFT)
  builtBy                 String
  builtByName             String?
  sentAt                  DateTime?
  pdfUrl                  String?
  viewedAt                DateTime?
  viewCount               Int                      @default(0)
  previousSnapshot        Json?
  /**
   * Set when a sales exec clicks "Mark Ready" — the moment pricing edits
   * stop and the package enters the costing team's verify-packages queue
   * (see verify-packages' baseWhere, gated on readyAt rather than sentAt).
   * Combined with the linked query's assignedAt, gives "time from
   * assignment to ready"; combined with sentAt, gives "time from ready to
   * sent". Cleared back to null only implicitly by never being reset —
   * re-marking ready after a rejection overwrites it with the new
   * timestamp, which is intentional: the queue/metrics reflect the latest
   * review cycle, not history (QueryTimeline carries the audit trail).
   */
  readyAt                 DateTime?
  readyBy                 String?
  readyByName             String?
  /**
   * Costing's pricing sign-off, independent of the client-facing status
   * (accepted/declined) and of whether it's actually been sent — a reviewer
   * confirms the pricing is correct (see approveCustomPackage in
   * verify-packages/actions.ts), which unlocks the exec's own separate send
   * step (shareCustomPackageWithClient, in package-builder/action.ts) but
   * doesn't trigger it. status only flips to SENT and pricingSnapshot gets
   * locked once the exec actually sends it.
   */
  verified                Boolean                  @default(false)
  verifiedAt              DateTime?
  verifiedBy              String?
  verifiedByName          String?
  /**
   * Set when the verification team sends a package's pricing back for
   * rework instead of verifying it — mirrors package_queries' structured
   * rejectionReasonId + free-text rejectionNote pattern. Cleared again
   * once the exec successfully re-submits (marks ready) after fixing it, so
   * a package is never both verified and rejected, and the rejection
   * reason stays visible to the exec until they've actually acted on it.
   */
  rejectedAt              DateTime?
  rejectedBy              String?
  rejectedByName          String?
  rejectionReasonId       String?
  rejectionNote           String?
  rejectionReason         RejectionReason?         @relation(fields: [rejectionReasonId], references: [id])
  /**
   * The exec's own equivalent of a rejection, in reverse — set when they
   * pull an already-verified package back out of "ready to share" (e.g. the
   * client asked for a change after approval) via requestPackageRevision
   * (package-builder/action.ts). Unlike a costing rejection this doesn't
   * come with a structured reason, just a free-text note explaining what
   * needs another look. Cleared by approveCustomPackage/rejectCustomPackage
   * once costing has acted on the resubmission — never cleared by
   * markPackageReady itself, so the note stays visible through the review
   * cycle it was requested for.
   */
  revisionRequestedAt     DateTime?
  revisionRequestedBy     String?
  revisionRequestedByName String?
  revisionNote            String?
  /**
   * Set the moment the exec has been shown (via the in-app toast poller)
   * that this package was verified-and-sent or rejected — prevents
   * re-notifying on every poll. Cleared whenever a fresh verify/reject
   * event happens (re-marking ready, or a new verify/reject decision), so
   * exactly one toast fires per event.
   */
  execNotifiedAt          DateTime?
  /**
   * Guards the +1h "check in with the client" auto follow-up (see
   * app/api/cron/package-followups) from being created twice for the same
   * send — set true the moment that follow-up is created, never reset.
   */
  followUpAutoCreated     Boolean                  @default(false)
  /**
   * Exec-pasted payment link (e.g. a Razorpay Payment Link created for this
   * exact locked total) — the client-facing "Pay Now" button opens this.
   * No gateway/webhook integration; purely a manual URL field.
   */
  paymentLink             String?
  /**
   * Frozen hotel/cab/ticket/margin/GST breakdown, computed server-side and
   * written once when the package is sent — lets the exec recheck later how
   * the delivered total was built, independent of any later catalog rate
   * changes. Never shown on the client-facing page.
   */
  pricingSnapshot         Json?
  /**
   * This package's own document template, overriding the house default from
   * itinerary_settings. Null means "use whatever the company default is" —
   * deliberately not defaulted to "classic", so that changing the house
   * template retroactively restyles every package that never made a choice.
   */
  template                String?
  /**
   * Per-package colour/font tweaks, applied over the template and over the
   * company's own overrides — for the occasional client whose branding the
   * exec needs to match. Null for the overwhelming majority.
   */
  themeOverrides          Json?
  flightsIncluded         Boolean                  @default(false)
  flightNotes             String?
  flightFrom              String?
  flightTo                String?
  trainIncluded           Boolean                  @default(false)
  trainNotes              String?
  trainFrom               String?
  trainTo                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  itineraries             custom_itineraries[]
  stops                   custom_package_stops[]
  tickets                 custom_package_tickets[]
  addOns                  custom_package_addons[]
  reviewNotes             package_review_notes[]
  query                   package_queries?         @relation(fields: [queryId], references: [id])

  @@index([queryId])
  @@index([builtBy])
  @@index([status])
  @@index([rejectionReasonId])
}

/**
 * Single global row (fixed id "singleton") holding the company-wide
 * itinerary document header/footer/contact details and the standard
 * Inclusions/Exclusions/T&C/Payment/Amendment/Benefits content — edited only
 * from /dashboard/itinerary-settings and never per-package, so every sent
 * itinerary stays consistent and Sales Executives can't drift it.
 */
model itinerary_settings {
  id                      String   @id @default("singleton")
  companyPhone            String   @default("+91 7807727100")
  companyEmail            String   @default("hello@dreamyatri.com")
  companyAddress          String   @default("Shimla, Himachal Pradesh - 171001")
  companyDescription      String   @default("At Dreams Yatri, we turn journeys into stories. From Himalayan escapes to luxury international holidays, our experts design custom, budget-smart, worry-free trips — so you focus on memories, not logistics.")
  documentDisclaimer      String   @default("This is a custom itinerary, subject to availability at the time of booking.")
  inclusions              String[]
  exclusions              String[]
  termsConditions         String[]
  paymentPolicy           String[]
  amendmentPolicy         String[]
  travelBenefits          String[]
  /**
   * Admin-defined extra policy blocks beyond the six fixed ones above —
   * each `{ id, title, items }`, rendered on the document as its own titled
   * bullet list in the order stored here.
   */
  customPolicySections    Json     @default("[]")
  /**
   * Default margin/GST % seeded into a brand-new package in the builder —
   * still per-package editable afterward on the Pricing tab, this is only
   * the starting value so execs aren't hand-typing the same house rate
   * into every draft.
   */
  defaultMarginPercentage Float    @default(25)
  defaultGstPercentage    Float    @default(5)
  /**
   * House document template (see doc-theme's TEMPLATES) and the company-wide
   * colour/font tweaks layered on top of it. Every package that hasn't chosen
   * its own template falls back to these, so rebranding all future itineraries
   * is one edit here rather than one per package.
   * Stored as a plain String rather than an enum: templates are a front-end
   * design catalogue that will gain entries faster than the schema should
   * churn, and an id that no longer resolves falls back to the house template
   * at render time instead of breaking the row.
   */
  defaultTemplate         String   @default("classic")
  /**
   * Partial ThemeOverrides — `{ accent?, paper?, ink?, fontHeading?, fontBody? }`.
   * Every value is re-validated at render (resolveDocTheme) before it reaches
   * a style attribute, so a malformed entry is ignored rather than painted.
   */
  themeOverrides          Json     @default("{}")
  updatedAt               DateTime @updatedAt
  updatedBy               String?
  updatedByName           String?
}

// A route stop within a custom package — e.g. "Manali, 2 nights" — used to
// build the day count/destination summary from a sequence of places rather
// than free-typing a single destination string and a raw night count.
model custom_package_stops {
  id              String          @id @default(cuid())
  customPackageId String
  name            String
  nights          Int             @default(1)
  /**
   * Manual override for the "Places You Gonna Visit" tile image — when
   * set, takes priority over the auto-resolved destination catalog photo.
   */
  image           String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  package         custom_packages @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

  @@index([customPackageId])
}

// A flight or train ticket the exec has priced into a custom package — one
// row per leg (e.g. onward + return flight are two rows), each with its own
// passenger breakdown and fare so the sum feeds straight into the package's
// computed pricing (see computeFinalPricing in the builder's page.tsx).
model custom_package_tickets {
  id              String          @id @default(cuid())
  customPackageId String
  type            TicketType
  provider        String?
  ticketNumber    String?
  fromPlace       String?
  toPlace         String?
  travelDate      DateTime?
  departureTime   String?
  arrivalTime     String?
  durationText    String?
  adults          Int             @default(0)
  children        Int             @default(0)
  infants         Int             @default(0)
  ticketCount     Int             @default(1)
  fare            Float?
  notes           String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  package         custom_packages @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

  @@index([customPackageId])
}

// A priced add-on for a custom package — e.g. "Honeymoon Kit", "Inner Line
// Permit" — each with its own per-unit price and quantity. Subtotal (price ×
// quantity, summed across rows) feeds into the package's computed pricing
// the same way hotel/cab costs do — see computeFinalPricing in the builder's
// page.tsx, which applies the standard (configurable, 25% by default)
// margin to add-ons, unlike tickets which only ever carry a flat 5%.
model custom_package_addons {
  id              String          @id @default(cuid())
  customPackageId String
  name            String
  price           Float           @default(0)
  quantity        Int             @default(1)
  notes           String?
  /**
   * Which itinerary day this was added under (e.g. added while working on
   * Day 2's hotel) — null means added generically (Package Details tab,
   * not tied to any day). Drives where it renders in the document: under
   * that day's Hotel section when set, in the general list when null.
   */
  day             Int?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  package         custom_packages @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

  @@index([customPackageId])
}

/**
 * A team-built Google-Ads-style landing page, published at /offers/[slug].
 * Distinct from the `packages` catalog (browsable site pages) and
 * `custom_packages` (per-client CRM quotes) — this is marketing collateral
 * for a single ad campaign/destination, built by picking from the catalog
 * and/or adding one-off cards (see LandingPageItem), with its own lead form
 * that writes into package_queries via source LANDING_PAGE (see
 * app/actions/enquiry/submit.ts).
 */
model LandingPage {
  id                      String            @id @default(cuid())
  /**
   * The path segment after /offers/ — e.g. "andaman-family-holiday".
   */
  slug                    String            @unique
  title                   String
  seoTitle                String
  description             String
  seoDescription          String
  /**
   * Optional now — the public hero auto-builds an animated slider from the
   * package items marked `showInHero` (see LandingPageItem). Only used as a
   * static fallback background when no items are marked for the hero rail.
   */
  heroImageUrl            String?
  /**
   * Small label above the hero title, e.g. "Andaman · Family Holiday" — falls back to title if unset.
   */
  heroEyebrow             String?
  /**
   * Big hero title override, e.g. "FAMILY HOLIDAY" — falls back to title if unset.
   */
  heroHeadline            String?
  /**
   * Free-text destination, prefilled into the lead form's `destination` field.
   */
  destination             String?
  status                  LandingPageStatus @default(DRAFT)
  /**
   * Seconds after page load before the enquiry modal auto-opens.
   */
  popupDelaySeconds       Int               @default(15)
  /**
   * Used for both the floating Call and WhatsApp buttons.
   */
  contactPhone            String
  /**
   * gtag `send_to` values (e.g. "AW-123456789/AbCdEfGh") for this page's
   * three trackable actions — each optional and independent, since a page
   * may only care about tracking some of them. No conversion fires for an
   * action whose field is left blank.
   */
  googleAdsSendToForm     String?
  googleAdsSendToCall     String?
  googleAdsSendToWhatsapp String?
  /**
   * `{ question: string, answer: string }[]` — same flexible-JSON pattern as custom_packages.extraPolicyItems.
   */
  faqs                    Json              @default("[]")
  /**
   * `{ authorName: string, authorRole?: string, quote: string, rating?: number }[]`.
   */
  testimonials            Json              @default("[]")
  createdBy               String
  createdByName           String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  items                   LandingPageItem[]

  @@index([slug])
  @@index([status])
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
}

/**
 * One package card on a landing page — either linked back to a real catalog
 * `packages` row (packageId set, for traceability) or fully custom
 * (packageId null). Fields are always a denormalized snapshot filled in at
 * add-time rather than a live join, so a landing page never breaks or
 * silently changes if the source catalog package is edited/deactivated
 * later.
 */
model LandingPageItem {
  id            String      @id @default(cuid())
  landingPageId String
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  packageId     Int?
  title         String
  imageUrl      String
  /**
   * Short editorial blurb shown on the card face, e.g. "Port Blair's Cellular Jail, Havelock's Radhanagar Beach…" — prefilled from the catalog package's own description when added from the catalog.
   */
  description   String?
  /**
   * e.g. 4.7 — shown as a star-rating pill on the card. Null hides the pill rather than showing a fabricated number.
   */
  rating        Float?
  /**
   * e.g. "5D / 4N" or a short route string.
   */
  routeLabel    String?
  /**
   * Free text so it can carry a suffix, e.g. "₹16,999/person".
   */
  priceLabel    String?
  /**
   * Ribbon shown on the card, e.g. "Best Seller", "Most Popular".
   */
  badgeLabel    String?
  /**
   * Up to 4 items marked true appear in the rotating hero rail.
   */
  showInHero    Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([landingPageId])
}

enum TicketType {
  FLIGHT
  TRAIN
  HELICOPTER
  BUS
  /**
   * Anything else the exec needs to price as a ticket/transfer line item
   * (ferry, zipline, cable car, private transfer, etc.) — the human-readable
   * description lives in the ticket's own `provider` field, same as every
   * other type.
   */
  OTHER
}

model custom_itineraries {
  id                            String                        @id @default(cuid())
  customPackageId               String
  day                           Int
  title                         String
  description                   String?
  meals                         String[]
  accommodation                 String?
  accommodationPhoto            String?
  accommodationRoomPhotos       String[]                      @default([])
  accommodationLocation         String?
  accommodationRoomSpecs        String?
  /// Star rating snapshotted off the hotel at pick time (hotels.stay_type,
  /// free text — "4 Star", sometimes "Boutique"). Denormalised for the same
  /// reason as accommodationRoomSpecs above: the client-facing page and the
  /// PDF render from this row alone and never see roomPricingId, so anything
  /// the document displays has to live here rather than be joined back.
  accommodationStarRating       String?
  accommodationRoomCapacity     Int?
  /**
   * Room-level occupancy caps snapshotted from hotel_rooms at the moment a
   * catalog room is picked (see HotelRoomResult.maxAdults/maxChildren/
   * extraBedCapacity) — kept on the itinerary row itself, not re-joined live,
   * same reasoning as accommodationRoomCapacity above: what's shown here
   * should never silently drift just because someone edited the hotel's
   * catalog listing after this day was booked. Null for a hand-typed/manual
   * day (no roomPricingId) — there's no catalog capacity to snapshot.
   */
  accommodationMaxAdults        Int?
  accommodationMaxChildren      Int?
  accommodationExtraBedCapacity Int?
  /**
   * Mattress/rollaway-bed count for a day with NO catalog roomPricingId —
   * either the hotel team fulfilling an "Add Hotels by Team" request
   * (fillPendingHotel) or a sales exec hand-typing a hotel in the builder.
   * A catalog-picked room's mattress count is computed instead, live, from
   * accommodationExtraBedCapacity + the party size (see room-capacity.ts) —
   * this field only exists because that computation has nothing to work
   * from once there's no catalog room behind the day.
   */
  manualExtraBeds               Int?
  roomPricingId                 Int?
  /**
   * Overrides the auto-computed (adults+children ÷ room capacity) room
   * count for the primary `roomPricingId` above — set when the exec
   * explicitly says how many of that room type are needed instead of
   * letting occupancy drive it. Null keeps the auto-computed behavior.
   */
  roomsCount                    Int?
  /**
   * Additional, DIFFERENT room types booked for the same night (e.g. one
   * couple in a Deluxe Room, another in a Suite) — each a
   * {roomPricingId, label, quantity} entry; priced by summing quantity ×
   * that room's own resolved per-night rate, no auto occupancy/mattress
   * logic (that only applies to the primary roomPricingId above).
   */
  extraRooms                    Json?
  cabPricingId                  Int?
  /**
   * Same override pattern as roomsCount, for the primary cabPricingId.
   */
  cabQuantity                   Int?
  /**
   * Additional, DIFFERENT cabs for the same day (e.g. one Sedan + one
   * SUV) — each a {cabPricingId, label, quantity} entry.
   */
  extraCabs                     Json?
  hotelCheckIn                  String?
  hotelCheckOut                 String?
  hotelMealPlan                 String?
  /**
   * Set when the exec can't find a catalog hotel for this day and flags it
   * for the hotel team instead of leaving it silently blank (see
   * /dashboard/hotel-requests). While true, accommodation/roomPricingId etc.
   * above stay empty — a day is either catalog-picked/manually-typed, or
   * pending, never both. Blocks markPackageReady until cleared.
   */
  hotelPending                  Boolean                       @default(false)
  hotelPendingNote              String?
  /**
   * Property type the exec wants for a pending request (e.g. "RESORT",
   * "STAR_4" — same keys as the client's stayPreference chips), shown to the
   * hotel team on /dashboard/hotel-requests so they know what to look for.
   * Cleared whenever hotelPending goes false (same lifecycle as
   * hotelPendingNote) — only meaningful while a request is outstanding.
   * Rooms needed / mattresses needed / meal plan for the request reuse
   * roomsCount / manualExtraBeds / hotelMealPlan below rather than adding
   * dedicated columns — those fields are otherwise unused while hotelPending
   * is true (no catalog room, no manual fill yet) and fillPendingHotel
   * already overwrites them with the team's actual fulfillment values.
   */
  hotelRequestType              String?
  hotelRequestedAt              DateTime?
  hotelFilledAt                 DateTime?
  hotelFilledById               String?
  hotelFilledByName             String?
  /**
   * Internal note the hotel team adds when fulfilling a pending request
   * (e.g. "confirmed by phone, no early check-in available") — shown to the
   * sales exec in the builder's Hotel Info day card, but deliberately kept
   * out of `notes` above (which IS rendered in the itinerary PDF) since this
   * is ops-to-sales communication, not something meant for the client.
   */
  hotelFillNote                 String?
  /**
   * Set once PackageStatusNotifier's poller has surfaced the "hotel added
   * for <package>" toast to the exec for this fill — same one-shot pattern
   * as custom_packages.execNotifiedAt, kept as its own per-day field rather
   * than reusing that one so a hotel-fill toast can't suppress (or be
   * suppressed by) the separate approved/rejected toast on the same package.
   */
  hotelFillNotifiedAt           DateTime?
  /**
   * B2B price/night the hotel team enters when fulfilling a pending request
   * — used instead of hotel_room_pricing lookups (roomPricingId stays null
   * for these days) by computeBuilderHotelPricing's manual-price branch.
   */
  manualHotelPricePerNight      Float?
  /**
   * Price per extra mattress/rollaway bed for a day with NO catalog
   * roomPricingId — the manual counterpart to hotel_room_pricing.extra_bed_rate.
   * Without this, manualExtraBeds above had no rate to multiply against, so a
   * hand-typed or hotel-team-filled day never actually charged for the
   * mattresses it listed.
   */
  manualExtraBedRate            Float?
  /**
   * Costing's per-day correction to what this day's hotel/cab would
   * otherwise cost (catalog rate, or manualHotelPricePerNight above) — set
   * from the Edit Pricing screen on /dashboard/verify-packages/[id] when a
   * specific day's line item is wrong, instead of one lump sum for the whole
   * trip. computeBuilderHotelPricing/computeBuilderCabPricing use these in
   * place of the computed total for that day when present. Cleared back to
   * null has no special meaning here — the exec never sets these; only
   * costing does, and only while the package is READY for review.
   */
  hotelPriceOverride            Float?
  cabPriceOverride              Float?
  transport                     String?
  transportPhoto                String?
  transportVehicleType          String?
  transportSeats                Int?
  transportPickup               String?
  transportPickupLat            Float?
  transportPickupLng            Float?
  transportDrop                 String?
  /**
   * Coordinates for transportDrop, the counterpart to transportPickupLat/Lng.
   * Needed to route between the two — road distance and drive time are derived
   * from a real routing call, not from the place names.
   */
  transportDropLat              Float?
  transportDropLng              Float?
  transportDistanceKm           Float?
  /**
   * Free-text estimate like "3h 15m" — typed by the exec or filled in by the
   * AI Itinerary Builder, shown in the Transport/Cab section of the day.
   */
  transportTravelTime           String?
  notes                         String?
  /**
   * Optional heading for `notes`. Falls back to the tone's own label when
   * empty, so a note never renders headless.
   */
  notesTitle                    String?
  /**
   * Tone for `notes` — mirrors itinerary_notes.type in the admin catalog
   * (warning | info | error | success | neutral) so both note systems speak
   * the same vocabulary. Null reads as neutral.
   */
  notesType                     String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  package                       custom_packages               @relation(fields: [customPackageId], references: [id], onDelete: Cascade)
  activities                    custom_itinerary_activities[]

  @@index([customPackageId])
  @@index([day])
  @@index([hotelPending])
}

model custom_itinerary_activities {
  id          String             @id @default(cuid())
  itineraryId String
  title       String
  description String?
  photo       String?
  photos      String[]           @default([])
  photoLabels String[]           @default([])
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  itinerary   custom_itineraries @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
}

model blog_posts {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  title          String
  excerpt        String?
  content        Json
  cover_image    String?
  status         BlogStatus             @default(DRAFT)
  rejection_note String?
  read_time      Int?
  published_at   DateTime?
  author_id      String
  reviewed_by_id String?
  reviewed_at    DateTime?
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt
  categories     blog_post_categories[]
  tags           blog_post_tags[]
  author         User                   @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([author_id])
  @@index([status])
  @@index([slug])
  @@index([published_at])
  @@map("blog_posts")
}

model blog_categories {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique
  slug        String                 @unique
  description String?
  is_active   Boolean                @default(true)
  sort_order  Int                    @default(0)
  posts       blog_post_categories[]

  @@index([slug])
  @@index([is_active])
  @@map("blog_categories")
}

model blog_tags {
  id    Int              @id @default(autoincrement())
  name  String           @unique
  slug  String           @unique
  posts blog_post_tags[]

  @@index([slug])
  @@map("blog_tags")
}

model blog_post_categories {
  post_id     String
  category_id Int
  category    blog_categories @relation(fields: [category_id], references: [id])
  post        blog_posts      @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([post_id, category_id])
  @@index([category_id])
  @@map("blog_post_categories")
}

model blog_post_tags {
  post_id String
  tag_id  Int
  post    blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag     blog_tags  @relation(fields: [tag_id], references: [id])

  @@id([post_id, tag_id])
  @@index([tag_id])
  @@map("blog_post_tags")
}

