// ── Channel-management Phase 1: per-date ARI ledger ───────────────────────────
// One row per room-type per calendar date. Carries Availability (units),
// an optional Rate override, and Inventory restrictions. The base nightly price
// still comes from the existing season/weekend/occupancy pricing engine
// (hotel_room_pricing → seasons); `price_override` pins a single date when set.
// available = stop_sell ? 0 : max(0, total_units - booked_units)
model hotel_room_availability {
  id                  Int         @id @default(autoincrement())
  hotel_id            Int
  room_id             Int
  date                DateTime    @db.Date
  total_units         Int
  booked_units        Int         @default(0)
  stop_sell           Boolean     @default(false)
  price_override      Decimal?    @db.Decimal(10, 2)
  min_los             Int?
  max_los             Int?
  // Days before check-in a booking must/can be made — e.g. min 1 blocks
  // same-day bookings, max limits how far out a "last-minute only" rate sells.
  min_advance_days    Int?
  max_advance_days    Int?
  closed_to_arrival   Boolean     @default(false)
  closed_to_departure Boolean     @default(false)
  note                String?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt
  room                hotel_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)
  hotel               hotels      @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@unique([room_id, date])
  @@index([hotel_id, date])
  @@index([room_id, date])
  @@map("hotel_room_availability")
}

// ── Channel-management Phase 2: reservation record ────────────────────────────
// A hold against the availability ledger for one room type + stay. Created inside
// the same transaction as the inventory hold (atomic). `hold_key` is the caller's
// idempotency key (dedupes double-creates, e.g. webhook retries). `released_at`
// guards exactly-once inventory release on cancel. `source` attributes the channel.
model hotel_reservation {
  id           String                 @id @default(cuid())
  hotel_id     Int
  room_id      Int
  check_in     DateTime               @db.Date
  check_out    DateTime               @db.Date
  units        Int                    @default(1)
  status       HotelReservationStatus @default(HELD)
  source       String                 @default("direct")
  external_ref String?
  hold_key     String                 @unique
  guest_name   String?
  guest_email  String?
  guest_phone  String?
  currency     String                 @default("INR")
  gross_amount Decimal?               @db.Decimal(10, 2)
  net_amount   Decimal?               @db.Decimal(10, 2)
  commission   Decimal?               @db.Decimal(10, 2)
  booking_id   String?
  notes        String?
  confirmed_at DateTime?
  cancelled_at DateTime?
  released_at  DateTime?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  room         hotel_rooms            @relation(fields: [room_id], references: [id], onDelete: Cascade)
  hotel        hotels                 @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id, check_in])
  @@index([room_id, check_in])
  @@index([source])
  @@index([status])
  @@map("hotel_reservation")
}

enum HotelReservationStatus {
  HELD
  CONFIRMED
  CANCELLED
}

// ── Channel-management Phase 5: connection + mapping ──────────────────────────
// A connection links a hotel to one distribution channel (via a connectivity
// provider like Channex). No OTA secrets are stored here — the provider holds
// them; we keep the provider's external id + sync status. `settings` is non-secret.
model hotel_channel_connection {
  id             String                       @id @default(cuid())
  hotel_id       Int
  channel        String // 'booking.com' | 'agoda' | 'mmt' | 'airbnb' | 'expedia' ...
  provider       String                       @default("channex")
  external_id    String? // provider's property/channel id
  status         ChannelConnectionStatus      @default(DRAFT)
  settings       Json?
  last_synced_at DateTime?
  last_error     String?
  is_active      Boolean                      @default(true)
  created_at     DateTime                     @default(now())
  updated_at     DateTime                     @updatedAt
  hotel          hotels                       @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  room_mappings  hotel_channel_room_mapping[]

  @@unique([hotel_id, channel])
  @@index([hotel_id])
  @@map("hotel_channel_connection")
}

// Maps our room (and optional rate plan) to the channel's room/rate codes.
// `pricing_id` null = room-level mapping (no specific rate plan).
model hotel_channel_room_mapping {
  id              String                   @id @default(cuid())
  connection_id   String
  room_id         Int
  pricing_id      Int? // our hotel_room_pricing (rate plan); null = room-level
  channel_room_id String // OTA/provider room-type code
  channel_rate_id String? // OTA/provider rate-plan code
  is_active       Boolean                  @default(true)
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt
  connection      hotel_channel_connection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  room            hotel_rooms              @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, room_id, pricing_id])
  @@index([connection_id])
  @@index([room_id])
  @@map("hotel_channel_room_mapping")
}

enum ChannelConnectionStatus {
  DRAFT
  CONNECTED
  ERROR
  PAUSED
}

// ── Channel-management Phase 6: sync reliability ──────────────────────────────
// Outbox of ARI pushes (and other outbound sync work). A worker claims due rows
// (FOR UPDATE SKIP LOCKED), calls the provider, and marks DONE / retries with
// backoff / DEAD after max_attempts. Provider-agnostic; the handler is injected.
model hotel_sync_event {
  id              String          @id @default(cuid())
  hotel_id        Int
  connection_id   String?
  room_id         Int?
  type            String
  payload         Json
  status          SyncEventStatus @default(PENDING)
  attempts        Int             @default(0)
  max_attempts    Int             @default(8)
  next_attempt_at DateTime        @default(now())
  last_error      String?
  idempotency_key String?         @unique
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  processed_at    DateTime?

  @@index([status, next_attempt_at])
  @@index([hotel_id])
  @@map("hotel_sync_event")
}

enum SyncEventStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  DEAD
}

// Inbound channel webhooks (e.g. Channex booking notifications). Dedup on
// (provider, event_id) so a re-delivered webhook is processed exactly once.
model hotel_channel_webhook {
  id           String    @id @default(cuid())
  provider     String
  event_id     String
  event_type   String?
  payload      Json
  processed    Boolean   @default(false)
  error        String?
  received_at  DateTime  @default(now())
  processed_at DateTime?

  @@unique([provider, event_id])
  @@index([processed])
  @@map("hotel_channel_webhook")
}

