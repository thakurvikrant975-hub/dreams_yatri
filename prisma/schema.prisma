  // ── Policy wizard fields ───────────────────────────────────────────────────
  cancellation_policy         HotelCancellationPolicy?
  allow_unmarried_couples     Boolean?
  show_couple_tag             Boolean?
  allow_guests_below_18       Boolean?
  allow_male_only_groups      Boolean?
  allow_same_city_id          Boolean?
  smoking_allowed             Boolean?
  parties_events_allowed      Boolean?
  wheelchair_accessible       Boolean?
  allow_outside_visitors      Boolean?
  pets_on_property            Boolean?
  pets_allowed                Boolean?
  allowed_pet_types           String[]                   @default([])
  pet_extra_charges           Boolean?
  pets_restricted_areas       String?
  pets_without_leash          Boolean?
  pet_food_available          Boolean?
  checkin_24_hours            Boolean?
  acceptable_id_proofs        String[]                   @default([])
  infant_free_occupancy       Boolean?
  infant_complimentary_food   Boolean?
  extra_bed_included          Boolean?
  provide_bed_extra_adults    Boolean?
  provide_bed_extra_kids      Boolean?
  // ── Extra bed detail fields ────────────────────────────────────────────────
  extra_bed_adults_avail      String?
  extra_bed_adults_types      String[]                   @default([])
  extra_cot_charge_adult      String?
  extra_mattress_charge_adult String?
  extra_sofa_charge_adult     String?
  extra_bed_kids_avail        String?
  extra_bed_kids_types        String[]                   @default([])
  extra_cot_charge_child      String?
  extra_mattress_charge_child String?
  extra_sofa_charge_child     String?
  extra_crib_charge_child     String?
  // ── Meal rack prices ──────────────────────────────────────────────────────
  meal_price_breakfast        String?
  meal_price_lunch            String?
  meal_price_dinner           String?
  // ── Homestay-specific wizard fields ──────────────────────────────────────
  hosted_as                   String?
  host_lives_at_property      Boolean?
  // ── Homestay Rooms & Spaces ────────────────────────────────────────────────
  hs_bedrooms                 Int?
  hs_bathrooms                Int?
  hs_has_kitchen              Boolean?
  hs_additional_spaces        Json?
  hs_bedroom_details          Json?
  hs_bathroom_details         Json?
  hs_kitchen_details          Json?
  hs_space_items              Json?
  // ── Homestay Finance wizard fields ────────────────────────────────────────
  ownership_type              String?
  has_registration_doc        Boolean?
  relationship_doc_type       String?
  id_proof_type               String?
  tan_number                  String?
  // ── Homestay Policy wizard fields ─────────────────────────────────────────
  has_check_in_end_time       Boolean?
  check_in_end_time           String?
  smoking_areas               String?
  entry_exit_restrictions     Boolean?
  noise_policy                String?
  pet_charge_amount           String?
  pet_count                   Int?
  food_kitchen_available      Boolean?
  caretaker_stays             Boolean?
  caretaker_details           String?
  caretaker_availability      String?
  caretaker_services          String[]                   @default([])
  caretaker_knowledge         String[]                   @default([])
  caretaker_helps_cleaning    Boolean?
  self_checkin_smart_door     Boolean?
  host_greets_helps           Boolean?
  caretaker_greets_helps      Boolean?
  building_staff_keys         Boolean?
  custom_policy               String?
  // ── Meals, Pricing & Availability wizard fields ───────────────────────────
  prop_num_units              Int?
  prop_meal_option            String?
  prop_base_occupancy         Int?
  prop_max_adults             Int?
  prop_max_children           Int?
  prop_max_occupancy          Int?
  prop_avail_from             DateTime?
  prop_avail_to               DateTime?
  prop_base_rate              Decimal?                   @db.Decimal(10, 2)
  prop_extra_adult            Decimal?                   @db.Decimal(10, 2)
  prop_child_rate             Decimal?                   @db.Decimal(10, 2)
  // ── Finance & Legal wizard fields ─────────────────────────────────────────
  bank_account_number         String?
  bank_ifsc_code              String?
  bank_name                   String?
  bank_consent_given          Boolean                    @default(false)
  gstin_number                String?
  pan_number                  String?
  business_type               HotelBusinessType?
  msme_number                 String?
  property_documents          Json?
  wizard_step                 Int                        @default(0)
  bookingHotels               BookingHotel[]
  childPolicies               hotel_child_policies[]
  image_categories            hotel_image_categories[]
  images                      hotel_images[]
  room_pricing                hotel_room_pricing[]
  meal_pricing                hotel_meal_pricing[]
  addons                      hotel_addons[]
  hotelRooms                  hotel_rooms[]
  room_availability           hotel_room_availability[]
  reservations                hotel_reservation[]
  channel_connections         hotel_channel_connection[]
  conversations               conversation[]
  reviews                     hotel_review[]
  wishlisted_by               hotel_wishlist[]
  landmarks                   hotel_landmark[]
  destination                 destinations?              @relation(fields: [destination_id], references: [id])
  location                    Location?                  @relation(fields: [location_id], references: [id])
  packageBookings             PackageBookingHotel[]
  owner                       HotelOwner?                @relation(fields: [owner_id], references: [id])
  ownerNotifications          HotelOwnerNotification[]

  @@index([destination_id, is_active])
  @@index([location_id])
  @@index([slug])
  @@index([owner_id])
  @@index([approval_status])
  // Trigram GIN indexes — let ILIKE '%term%' hotel search (expiring-rates,
  // hotel-inventory, package-builder hotel picker) use an index instead of
  // a full-table scan + regex per row.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin)
}

