  submitted_at                DateTime?
  approved_at                 DateTime?
  approved_by_id              String?
  rejection_reason            String?
  // ── Internal QC review ─────────────────────────────────────────────────────
  // Separate from listing_status (a hotel-connect-only owner workflow): this is
  // the internal team's own sign-off on a hotel's content, and applies to every
  // hotel however it was created. Deliberately does NOT gate visibility —
  // a PENDING hotel still sells; the flag only tells the team what a manager
  // has actually checked.
  approval_status             HotelApprovalStatus        @default(PENDING)
  approval_notes              String?
  approval_flags              String[]                   @default([])
  approval_reviewed_at        DateTime?
  approval_reviewed_by_id     String?
