generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Regions ───────────────────────────────────────────────────────────────────
model regions {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  thumbnail   String?
  cover_image String?
  description String?
  meta_title  String?
  meta_desc   String?
  country     String   @default("India")
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  destinations destinations[]

  @@index([slug])
}

// ── Destinations ──────────────────────────────────────────────────────────────
model destinations {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  thumbnail   String?
  cover_image String?
  description String?
  meta_title  String?
  meta_desc   String?
  country     String   @default("India")
  region_id   Int
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  region     regions      @relation(fields: [region_id], references: [id])
  packages   packages[]
  hotels     hotels[]
  activities activities[]

  bookings Booking[]   // ← add this

  @@index([region_id])
  @@index([slug])
}

// ── Categories ────────────────────────────────────────────────────────────────
model categories {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  meta_title  String?
  meta_desc   String?
  parent_id   Int?
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)

  parent   categories?         @relation("CategoryTree", fields: [parent_id], references: [id])
  children categories[]        @relation("CategoryTree")
  packages package_categories[]

  @@index([parent_id])
  @@index([slug])
}

// ── Tags ──────────────────────────────────────────────────────────────────────
model tags {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  group String?

  packages package_tags[]

  @@index([group])
  @@index([slug])
}

// ── Packages ──────────────────────────────────────────────────────────────────
model packages {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  thumbnail      String?
  cover_image    String?
  description    String?
  meta_title     String?
  meta_desc      String?
  destination_id Int
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  destination     destinations              @relation(fields: [destination_id], references: [id])
  images          package_images[]
  durations       package_durations[]
  stay_categories package_stay_categories[]
  pricing         package_pricing[]
  itineraries     package_itineraries[]
  tags            package_tags[]
  categories      package_categories[]
  hotels          package_hotels[]
  activities      package_activities[]

  @@index([destination_id, is_active])
  @@index([slug])
}

// ── Package Images ────────────────────────────────────────────────────────────
model package_images {
  id          Int      @id @default(autoincrement())
  package_id  Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  package packages @relation(fields: [package_id], references: [id])

  @@index([package_id])
}

// ── Package Durations ─────────────────────────────────────────────────────────
model package_durations {
  id         Int      @id @default(autoincrement())
  package_id Int
  slug       String
  label      String
  days       Int
  nights     Int
  routes     Json
  meta_title String?
  meta_desc  String?
  is_default Boolean  @default(false)
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  package     packages              @relation(fields: [package_id], references: [id])
  pricing     package_pricing[]
  itineraries package_itineraries[]

  @@unique([package_id, slug])
  @@index([package_id, is_active])
}

// ── Package Stay Categories ───────────────────────────────────────────────────
model package_stay_categories {
  id                Int      @id @default(autoincrement())
  package_id        Int
  slug              String
  label             String
  description       String?
  min_duration_days Int?
  is_default        Boolean  @default(false)
  sort_order        Int      @default(0)
  is_active         Boolean  @default(true)

  package packages           @relation(fields: [package_id], references: [id])
  pricing package_pricing[]
  hotels  package_hotels[]

  @@unique([package_id, slug])
  @@index([package_id, is_active])
}

// ── Package Pricing Matrix ────────────────────────────────────────────────────
model package_pricing {
  id               Int      @id @default(autoincrement())
  package_id       Int
  duration_id      Int
  route_index      Int
  stay_category_id Int
  price            Decimal  @db.Decimal(10, 2)
  original_price   Decimal? @db.Decimal(10, 2)
  is_active        Boolean  @default(true)

  package       packages                @relation(fields: [package_id], references: [id])
  duration      package_durations       @relation(fields: [duration_id], references: [id])
  stay_category package_stay_categories @relation(fields: [stay_category_id], references: [id])

  @@unique([package_id, duration_id, route_index, stay_category_id])
  @@index([package_id, duration_id, is_active])
}

// ── Package Itineraries ───────────────────────────────────────────────────────
model package_itineraries {
  id           Int   @id @default(autoincrement())
  package_id   Int
  duration_id  Int
  day          Int
  title        String
  description  String?
  activities   Json
  activity_ids Json?
  meals        Json?
  route_index  Int?
  hotel_id     Int?
  hotel_days   Int?

  package  packages          @relation(fields: [package_id], references: [id])
  duration package_durations @relation(fields: [duration_id], references: [id])
  hotel    hotels?           @relation(fields: [hotel_id], references: [id])

  @@index([package_id, duration_id])
  @@index([hotel_id])
}

// ── Package Tags Junction ─────────────────────────────────────────────────────
model package_tags {
  package_id Int
  tag_id     Int

  package packages @relation(fields: [package_id], references: [id])
  tag     tags     @relation(fields: [tag_id], references: [id])

  @@id([package_id, tag_id])
  @@index([tag_id])
}

// ── Package Categories Junction ───────────────────────────────────────────────
model package_categories {
  package_id  Int
  category_id Int

  package  packages   @relation(fields: [package_id], references: [id])
  category categories @relation(fields: [category_id], references: [id])

  @@id([package_id, category_id])
  @@index([category_id])
}

// ── Hotels ────────────────────────────────────────────────────────────────────
model hotels {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  thumbnail      String?  // ← NEW — R2 key for package cards / listings
  description    String?
  meta_title     String?
  meta_desc      String?
  destination_id Int
  address        String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  star_rating    Int?
  category       String?
  amenities      Json?
  check_in_time  String?
  check_out_time String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  destination      destinations            @relation(fields: [destination_id], references: [id])
  images           hotel_images[]
  image_categories hotel_image_categories[]
  room_pricing     hotel_room_pricing[]
  packages         package_hotels[]
  itineraries      package_itineraries[]

  @@index([destination_id, is_active])
  @@index([slug])
}

// ── Hotel Image Categories — no slug ─────────────────────────────────────
model hotel_image_categories {
  id              Int      @id @default(autoincrement())
  hotel_id        Int
  room_pricing_id Int?     // null = hotel-level, set = room-specific
  name            String
  is_required     Boolean  @default(false)
  is_system       Boolean  @default(false)
  sort_order      Int      @default(0)

  hotel        hotels              @relation(fields: [hotel_id], references: [id])
  room_pricing hotel_room_pricing? @relation(fields: [room_pricing_id], references: [id])
  images       hotel_images[]

  @@index([hotel_id])
  @@index([room_pricing_id])
}

// ── Hotel Images — add category_id ───────────────────────────────────────
model hotel_images {
  id          Int      @id @default(autoincrement())
  hotel_id    Int
  category_id Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  hotel    hotels                 @relation(fields: [hotel_id], references: [id])
  category hotel_image_categories @relation(fields: [category_id], references: [id])

  @@index([hotel_id])
  @@index([category_id])
}

// ── hotel_room_pricing — add image_categories relation ────────────────────
model hotel_room_pricing {
  id                Int      @id @default(autoincrement())
  hotel_id          Int
  room_type         String
  description       String?
  occupancy         Int      @default(2)
  price_per_night   Decimal  @db.Decimal(10, 2)
  original_price    Decimal? @db.Decimal(10, 2)
  season            String   @default("all")
  amenities         Json?
  sort_order        Int      @default(0)
  margin_percentage Decimal  @db.Decimal(5, 2) @default(10)
  is_active         Boolean  @default(true)

  hotel            hotels                   @relation(fields: [hotel_id], references: [id])
  image_categories hotel_image_categories[]

  @@index([hotel_id, is_active])
  @@index([hotel_id, season])
}


// ── Package Hotels ────────────────────────────────────────────────────────────
model package_hotels {
  id               Int     @id @default(autoincrement())
  package_id       Int
  hotel_id         Int
  stay_category_id Int
  night_number     Int?
  is_recommended   Boolean @default(false)

  package       packages                @relation(fields: [package_id], references: [id])
  hotel         hotels                  @relation(fields: [hotel_id], references: [id])
  stay_category package_stay_categories @relation(fields: [stay_category_id], references: [id])

  @@index([package_id, stay_category_id])
  @@index([hotel_id])
}

// ── Activities ────────────────────────────────────────────────────────────────
model activities {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  description    String?
  meta_title     String?
  meta_desc      String?
  destination_id Int
  duration_hours Decimal? @db.Decimal(4, 1)
  difficulty     String?
  category       String?
  
  // ── Pricing (moved from activity_pricing) ──
  price             Decimal? @db.Decimal(10, 2)
  original_price    Decimal? @db.Decimal(10, 2)
  margin_percentage Decimal  @db.Decimal(5, 2) @default(0)
  pricing_type      String?  // per_person | flat | per_vehicle
  min_persons       Int?
  max_persons       Int?

  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  destination destinations      @relation(fields: [destination_id], references: [id])
  images      activity_images[]
  packages    package_activities[]

  @@index([destination_id, is_active])
  @@index([category])
  @@index([slug])
}

// ── Activity Images ───────────────────────────────────────────────────────────
model activity_images {
  id          Int      @id @default(autoincrement())
  activity_id Int
  url         String
  thumbnail   String?
  blur_base64 String?
  alt         String?
  sort_order  Int      @default(0)
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  activity activities @relation(fields: [activity_id], references: [id])

  @@index([activity_id])
}

// ── Package Activities ────────────────────────────────────────────────────────
model package_activities {
  id          Int      @id @default(autoincrement())
  package_id  Int
  activity_id Int
  duration_id Int
  day_number  Int
  is_optional Boolean  @default(false)
  extra_price Decimal? @db.Decimal(10, 2)

  package  packages   @relation(fields: [package_id], references: [id])
  activity activities @relation(fields: [activity_id], references: [id])

  @@index([package_id, duration_id])
  @@index([activity_id])
}

// ── Pricing Rules ─────────────────────────────────────────────────────────────
model pricing_rules {
  id         Int      @id @default(autoincrement())
  name       String
  type       String   // "percentage" | "fixed"
  value      Decimal  @db.Decimal(8, 2)
  applies_to String   // "hotel" | "activity" | "transport" | "all"
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([applies_to, is_active])
}

// ── Uploaded Images ───────────────────────────────────────────────────────────
model images {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique
  folder        String
  original_url  String
  thumbnail_url String
  blur_url      String
  blur_base64   String
  original_key  String
  thumbnail_key String
  blur_key      String
  width         Int
  height        Int
  size_bytes    Int
  original_size Int
  aspect_ratio  String
  created_at    DateTime @default(now())

  @@index([folder])
}

// OTP send schema
// schema.prisma

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

model User {
  id           String  @id @default(cuid())
  phone String? @unique
  country_code String

  // NextAuth required
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Role
  role Role @default(USER)
  status UserStatus @default(ACTIVE)


  // Personal
  gender        Gender?
  dateOfBirth   DateTime?
  nationality   String?
  maritalStatus MaritalStatus?
  anniversary   DateTime?

  // Location
  state String?
  city  String?

  // Travel Documents
  passportNumber         String?   @unique
  passportExpiryDate     DateTime?
  passportIssuingCountry String?

  // Tax
  panNumber String? @unique

  // Flags
  isProfileComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Otp {
  id        String    @id @default(cuid())
  phone     String?                        // ← add ?
  email     String?                        // ← add ?
  code      Int
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@index([email])                         // ← add email index
}


model MagicSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}



// enums

enum TripType {
  Adventure
  Leisure
  Pilgrimage
  Honeymoon
  Family
  Corporate
  Backpacking
  Wildlife
}

enum GroupType {
  Solo
  Couple
  Family
  Group
}

enum BudgetTier {
  Budget
  MidRange
  Luxury
  UltraLuxury
}

enum TripDuration {
  Weekend    // 2–3N
  Short      // 4–5N
  Week       // 6–8N
  Long       // 9–14N
  Extended   // 15N+
}

enum TravelMonth {
  Jan
  Feb
  Mar
  Apr
  May
  Jun
  Jul
  Aug
  Sep
  Oct
  Nov
  Dec
}

// model

model TravelPreference {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripTypes  TripType[]                        // multi
  groupType  GroupType?                        // single, optional
  budget     BudgetTier?                       // single, optional
  duration   TripDuration?                     // single, optional
  months     TravelMonth[]                     // multi

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("travel_preferences")
}


// schema.prisma — add these models

enum BookingStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  EMI
  CASH
}

enum PaymentGateway {
  RAZORPAY
  PHONEPE
  PAYU
  OFFLINE
}


model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  userId        String
  destinationId Int                               // ← Int to match destinations.id

  // Trip details
  tripType      TripType
  startDate     DateTime
  endDate       DateTime
  duration      Int
  travellers    Int           @default(1)
  status        BookingStatus @default(UPCOMING)

  // Pricing
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @db.Decimal(10, 2) @default(0)
  currency      String        @default("INR")

  // Meta
  notes         String?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   destinations  @relation(fields: [destinationId], references: [id])  // ← existing model
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id                String         @id @default(cuid())
  bookingId         String
  userId            String

  // Amount
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("INR")
 
  // Gateway details
  gateway           PaymentGateway
  method            PaymentMethod?
  status            PaymentStatus  @default(PENDING)

  // Razorpay / PhonePe specific
  gatewayOrderId    String?        // razorpay_order_id / phonepe txn ref
  gatewayPaymentId  String?        @unique  // razorpay_payment_id
  gatewaySignature  String?        // for Razorpay verification

  // Refund
  refundId          String?
  refundAmount      Decimal?       @db.Decimal(10, 2)
  refundedAt        DateTime?

  // Meta
  failureReason     String?
  paidAt            DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  booking           Booking        @relation(fields: [bookingId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([gatewayOrderId])
  @@map("payments")
}