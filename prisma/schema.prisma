// ── Booking: short-lived, server-computed, signed price quote ────────────────
// An immutable snapshot of a FullPricingBreakdown locked for a few minutes so
// the amount cannot drift between "review" and "pay". Selectors are stored as
// loose scalars (no FK) so historical quotes survive package edits/deletes.
enum QuoteStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

model package_quote {
  id               String      @id @default(cuid())
  package_id       Int
  duration_id      Int
  route_id         Int
  stay_category_id Int
  package_slug     String
  duration_slug    String
  route_slug       String
  stay_slug        String
  adults           Int
  children         Int         @default(0)
  infants          Int         @default(0)
  child_ages       Int[]       @default([])
  cab_type_ids     Int[]       @default([])
  travel_date      DateTime
  currency         String      @default("INR")
  breakdown        Json        // full FullPricingBreakdown snapshot
  base_cost        Decimal     @default(0) @db.Decimal(10, 2)
  margin_amount    Decimal     @default(0) @db.Decimal(10, 2)
  gst_amount       Decimal     @default(0) @db.Decimal(10, 2)
  total_amount     Decimal     @db.Decimal(10, 2)
  price_per_adult  Decimal     @default(0) @db.Decimal(10, 2)
  inputs_hash      String      // hash of price-affecting inputs (dedupe / drift id)
  signature        String      // HMAC over the canonical snapshot
  status           QuoteStatus @default(ACTIVE)
  expires_at       DateTime
  user_id          String?     // optional — set when a logged-in user requests it
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([package_id])
  @@index([status])
  @@index([expires_at])
  @@index([inputs_hash])
  @@index([user_id])
  @@map("package_quote")
}

model package_cab_options {
  id           Int      @id @default(autoincrement())
  package_id   Int
  cab_type     CabType
  capacity     Int
  is_default   Boolean  @default(false)
  is_active    Boolean  @default(true)
  rate_per_cab Decimal  @db.Decimal(10, 2)
  package      packages @relation(fields: [package_id], references: [id])

  @@unique([package_id, cab_type])
  @@map("package_cab_options")
}

model package_cab_types {
  id          Int                    @id @default(autoincrement())
  package_id  Int
  duration_id Int
  vehicle_id  Int
  label       String?
  note        String?
  is_default  Boolean                @default(false)
  is_active   Boolean                @default(true)
  sort_order  Int                    @default(0)
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt
  segments    package_cab_segments[]
  duration    package_durations      @relation(fields: [duration_id], references: [id], onDelete: Cascade)
  package     packages               @relation(fields: [package_id], references: [id], onDelete: Cascade)
  vehicle     vehicles               @relation(fields: [vehicle_id], references: [id])

  @@unique([package_id, duration_id, vehicle_id])
  @@index([package_id, duration_id])
  @@map("package_cab_types")
}

model package_cab_segments {
  id             Int               @id @default(autoincrement())
  cab_type_id    Int
  day_from       Int
  day_to         Int
  cab_pricing_id Int
  sort_order     Int               @default(0)
  cab_pricing    cab_pricing       @relation(fields: [cab_pricing_id], references: [id])
  cab_type       package_cab_types @relation(fields: [cab_type_id], references: [id], onDelete: Cascade)

  @@index([cab_type_id])
  @@map("package_cab_segments")
}

model package_policy_map {
  package_id Int
  policy_id  Int
  package    packages @relation(fields: [package_id], references: [id])
  policy     policies @relation(fields: [policy_id], references: [id])

  @@id([package_id, policy_id])
  @@index([policy_id])
}

model package_gallery {
  id          Int               @id @default(autoincrement())
  package_id  Int
  image_url   String
  source_type GallerySourceType
  source_id   Int?
  position    Int
  created_at  DateTime          @default(now())
  label       String?
  route_id    Int?
  package     packages          @relation(fields: [package_id], references: [id], onDelete: Cascade)
  route       package_routes?   @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([package_id])
  @@index([route_id])
}

model QueryFollowUp {
  id             String          @id @default(cuid())
  packageQueryId String
  note           String
  followUpAt     DateTime?
  createdAt      DateTime        @default(now())
  createdById    String?
  createdByName  String?
  packageQuery   package_queries @relation(fields: [packageQueryId], references: [id], onDelete: Cascade)

  @@index([packageQueryId])
  @@index([createdById])
}

model package_queries {
  id                String           @id @default(cuid())
  name              String
  email             String?
  phone             String
  countryCode       String           @default("IN")
  message           String?
  packageName       String?
  destination       String?
  travelDate        DateTime?
  groupSize         Int?
  source            QuerySource      @default(WEBSITE_FORM)
  gclid             String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  pageUrl           String?
  packageUrl        String?
  status            QueryStatus      @default(SUBMITTED)
  verified          Boolean          @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  rejectionReasonId String?
  rejectionNote     String?
  callAttempts      Int              @default(0)
  lastAttemptAt     DateTime?
  nextFollowUpAt    DateTime?
  assignedTo        String?
  assignedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  leadProfileId     String?
  assignedToName    String?
  closeReasonId     String?
  closeReasonOther  String?
  closedAt          DateTime?
  closedBy          String?
  requirements      Json?
  queryFollowUps    QueryFollowUp[]
  booking           Booking?
  custom_packages   custom_packages?
  lead_profiles     LeadProfile?     @relation(fields: [leadProfileId], references: [id])
  rejection_reasons RejectionReason? @relation(fields: [rejectionReasonId], references: [id])
  notes             QueryNote[]
  timeline          QueryTimeline[]

  @@index([assignedTo])
  @@index([createdAt])
  @@index([destination])
  @@index([status])
  @@index([verified])
}

model custom_packages {
  id             String               @id @default(cuid())
  queryId        String               @unique
  title          String
  destination    String
  startingPoint  String?
  totalDays      Int
  totalNights    Int
  travelDate     DateTime?
  adults         Int                  @default(1)
  children       Int                  @default(0)
  infants        Int                  @default(0)
  pricePerPerson Float?
  totalPrice     Float?
  currency       String               @default("INR")
  inclusions     String[]
  exclusions     String[]
  termsNotes     String?
  status         CustomPackageStatus  @default(DRAFT)
  builtBy        String
  builtByName    String?
  sentAt         DateTime?
  pdfUrl         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  itineraries    custom_itineraries[]
  query          package_queries      @relation(fields: [queryId], references: [id])

  @@index([queryId])
  @@index([builtBy])
  @@index([status])
}

model custom_itineraries {
  id              String          @id @default(cuid())
  customPackageId String
  day             Int
  title           String
  description     String?
  activities      String[]
  meals           String[]
  accommodation   String?
  transport       String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  package         custom_packages @relation(fields: [customPackageId], references: [id], onDelete: Cascade)

  @@index([customPackageId])
  @@index([day])
}

