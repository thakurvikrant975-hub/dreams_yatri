  property_sub_type           PropertySubType?
  star_rating                 Int?
  year_built                  Int?
  booking_since_year          Int?
  has_channel_manager         Boolean                    @default(false)
  channel_manager_name        String?
  contact_email               String?
  contact_mobile_cc           String?                    @default("+91")
  contact_mobile              String?
  // OTP verification is skipped in the wizard for now (SMS delivery isn't
  // wired up in every environment) — reserved for when it is re-enabled.
  contact_mobile_verified     Boolean                    @default(false)
  whatsapp_same_as_mobile     Boolean                    @default(false)
  contact_whatsapp            String?
  contact_landline            String?
