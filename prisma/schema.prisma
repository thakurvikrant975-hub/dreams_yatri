generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BookingMeal {
  id             String         @id @default(cuid())
  bookingId      String
  bookingHotelId String
  dayNumber      Int
  mealType       MealType
  foodPreference FoodPreference
  ratePerPerson  Decimal        @db.Decimal(10, 2)
  travellers     Int
  totalCost      Decimal        @db.Decimal(10, 2)
  bookingHotel   BookingHotel   @relation(fields: [bookingHotelId], references: [id], onDelete: Cascade)
  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([bookingHotelId])
  @@map("booking_meals")
}

model pricing_rules {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  value      Decimal  @db.Decimal(8, 2)
  applies_to String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([applies_to, is_active])
}

model User {
  id                     String            @id @default(cuid())
  phone                  String?           @unique
  name                   String?
  email                  String?           @unique
  gender                 Gender?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          MaritalStatus?
  anniversary            DateTime?
  state                  String?
  city                   String?
  passportNumber         String?           @unique
  passportExpiryDate     DateTime?
  passportIssuingCountry String?
  panNumber              String?           @unique
  isProfileComplete      Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  emailVerified          DateTime?
  image                  String?
  country_code           String?
  role                   Role              @default(USER)
  status                 UserStatus        @default(ACTIVE)
  whatsapp               String?           @unique
  accounts               Account[]
  sessions               Session[]
  blogPosts              blog_posts[]
  bookings               Booking[]
  payments               Payment[]
  travelPreference       TravelPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Otp {
  id        String    @id @default(cuid())
  phone     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  code      Int
  attempts  Int       @default(0)
  email     String?

  @@index([phone])
  @@index([email])
}

model MagicSession {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PendingContactVerification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  value     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("pending_contact_verifications")
}

model TravelPreference {
  id        String        @id @default(cuid())
  userId    String        @unique
  tripTypes TripType[]
  groupType GroupType?
  budget    BudgetTier?
  duration  TripDuration?
  months    TravelMonth[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

model Booking {
  id                      String                @id @default(cuid())
  bookingNumber           String                @unique
  userId                  String
  packageId               Int?
  destinationId           Int?
  tripType                TripType
  startDate               DateTime
  endDate                 DateTime
  duration                Int
  travellers              Int                   @default(1)
  status                  BookingStatus         @default(PENDING_REVIEW)
  cabType                 CabType               @default(INNOVA)
  roomSharingType         RoomSharingType       @default(SHARED)
  mealPlan                MealPlan              @default(MAP)
  hotelCost               Decimal               @default(0) @db.Decimal(10, 2)
  cabCost                 Decimal               @default(0) @db.Decimal(10, 2)
  mealCost                Decimal               @default(0) @db.Decimal(10, 2)
  subtotal                Decimal               @default(0) @db.Decimal(10, 2)
  marginAmount            Decimal               @default(0) @db.Decimal(10, 2)
  gstAmount               Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount             Decimal               @db.Decimal(10, 2)
  paidAmount              Decimal               @default(0) @db.Decimal(10, 2)
  currency                String                @default("INR")
  notes                   String?
  cancelledAt             DateTime?
  cancelReason            String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  currentDepartmentId     String?
  currentAssigneeId       String?
  hotelAssigneeId         String?
  hotelConfirmedAt        DateTime?
  hotelNotes              String?
  cabAssigneeId           String?
  cabConfirmedAt          DateTime?
  cabNotes                String?
  opsAssigneeId           String?
  opsReviewedAt           DateTime?
  rejectionReason         String?
  modificationNote        String?
  modificationRequestedBy String?
  paymentStatus           PaymentStatus         @default(PENDING)
  advancePaidAmount       Decimal               @default(0) @db.Decimal(10, 2)
  balanceDueAmount        Decimal               @default(0) @db.Decimal(10, 2)
  balanceDueDate          DateTime?
  sourceQueryId           String?               @unique
  convertedAt             DateTime?
  salesAgentId            String?
  salesAgentName          String?
  referredBy              String?
  referralSource          ReferralSource?
  opsAgentName            String?
  hotelAgentName          String?
  cabAgentName            String?
  confirmationEmailSentAt DateTime?
  confirmationEmailTo     String?
  totalAmount_paise       Int                   @default(0)
  advanceAmount_paise     Int                   @default(0)
  balanceAmount_paise     Int                   @default(0)
  quoteId                 String?               @unique
  quoteInputsHash         String?
  priceSnapshot           Json?
  paymentPlan             PaymentPlan?
  contactEmail            String?
  contactPhone            String?
  gstStateCode            String?
  packageUrl              String?
  bookingActivities       BookingActivity[]
  cabBookings             BookingCab[]
  hotelBookings           BookingHotel[]
  bookingMeals            BookingMeal[]
  timeline                BookingTimeline[]
  travellersList          BookingTraveller[]
  cabAssignee             TeamMember?           @relation("BookingCabAssignee", fields: [cabAssigneeId], references: [id])
  currentAssignee         TeamMember?           @relation("BookingCurrentAssignee", fields: [currentAssigneeId], references: [id])
  currentDepartment       Department?           @relation("BookingCurrentDept", fields: [currentDepartmentId], references: [id])
  destination             destinations?         @relation(fields: [destinationId], references: [id])
  hotelAssignee           TeamMember?           @relation("BookingHotelAssignee", fields: [hotelAssigneeId], references: [id])
  opsAssignee             TeamMember?           @relation("BookingOpsAssignee", fields: [opsAssigneeId], references: [id])
  package                 packages?             @relation(fields: [packageId], references: [id])
  sourceQuery             package_queries?      @relation(fields: [sourceQueryId], references: [id])
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageHotels           PackageBookingHotel[]
  installments            PaymentInstallment[]
  payments                Payment[]
  replacementOffers       ReplacementOffer[]
  documents               TripDocument[]
  conversations           conversation[]
  reviews                 hotel_review[]

  @@index([userId])
  @@index([packageId])
  @@index([status])
  @@map("bookings")
}

model TripDocument {
  id         String       @id @default(cuid())
  bookingId  String
  type       DocumentType
  fileUrl    String
  uploadedBy String
  uploadedAt DateTime     @default(now())
  booking    Booking      @relation(fields: [bookingId], references: [id])

  @@map("trip_documents")
}

/// An invoice or voucher the operations team fills in by hand.
///
/// The automatic documents (dashboard/package-bookings/[id]/invoice|voucher)
/// are derived entirely from a Booking row, so they only exist for trips sold
/// through the site. Ops also issues the same two documents for business that
/// never became a Booking — a walk-in, a B2B agent, a stay arranged over the
/// phone — and was doing it in Word. This is that document, stored so it can be
/// reopened, corrected and reprinted rather than retyped.
///
/// It deliberately does NOT reference Booking. A manual document is the record
/// of what was issued, not a shadow booking: nothing schedules against it,
/// nothing prices off it, and ops must be able to raise one for a trip the
/// system knows nothing about.
model ManualDocument {
  id                String             @id @default(cuid())
  type              ManualDocumentType
  /// Its own series (MINV-2026-0001 / MVCH-2026-0001) so a manual document can
  /// never be mistaken for — or collide with — a system booking number.
  documentNumber    String             @unique
  /// The date printed on the document. Separate from createdAt: ops routinely
  /// raises a document days after the service, dated when it was rendered.
  issueDate         DateTime
  guestName         String
  guestContact      String?
  /// Trip title on a voucher, service description on an invoice — the one line
  /// that identifies the document in a list.
  title             String
  startDate         DateTime?
  endDate           DateTime?
  travellers        Int                @default(1)
  /// Invoice grand total in paise; 0 on a voucher. A column rather than a
  /// payload read so the list can sort and total without parsing every row.
  totalAmount_paise Int                @default(0)
  /// The document body — line items and payments for an invoice, the itinerary
  /// and hotel/cab tables for a voucher. Shape is discriminated by `type` and
  /// validated in app/lib/manual-documents.ts.
  ///
  /// JSON rather than tables because these are issued artefacts: nothing joins
  /// to a manual voucher's day rows, and normalising them would cost six tables
  /// that only ever get read back together, as a whole document.
  payload           Json
  /// Internal note — why this was raised, who asked for it. Never printed.
  notes             String?
  createdById       String?
  createdByName     String?
  updatedByName     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         TeamMember?        @relation("ManualDocumentAuthor", fields: [createdById], references: [id])

  @@index([type, issueDate])
  @@index([guestName])
  @@map("manual_documents")
}

enum ManualDocumentType {
  INVOICE
  VOUCHER
}

model BookingHotel {
  id                String            @id @default(cuid())
  bookingId         String
  dayNumber         Int
  cityName          String
  checkInDate       DateTime
  checkOutDate      DateTime
  hotelId           Int
  roomType          String
  roomsCount        Int
  ratePerRoom       Decimal           @db.Decimal(10, 2)
  totalCost         Decimal           @db.Decimal(10, 2)
  isConfirmed       Boolean           @default(false)
  confirmedAt       DateTime?
  confirmedById     String?
  // Pre-travel double-check with the hotel, separate from the initial
  // confirmedAt above — a hotel can still cancel/change a stay it confirmed
  // weeks earlier, so this is set from the Upcoming Guests page's own call-
  // and-verify pass in the run-up to arrival, not at initial verification.
  reconfirmedAt     DateTime?
  reconfirmedById   String?
  reconfirmedByName String?
  notes             String?
  status            FulfillmentStatus @default(PENDING)
  voucherUrl        String?
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedBy       TeamMember?       @relation(fields: [confirmedById], references: [id])
  hotel             hotels            @relation(fields: [hotelId], references: [id])
  meals             BookingMeal[]

  @@unique([bookingId, dayNumber])
  @@index([bookingId])
  @@index([hotelId])
  @@map("booking_hotels")
}

enum ConversationSender {
  HOST
  GUEST
  SYSTEM
  AGENT // future support/help conversations — unused by hotel-guest chat today
}

// The only kind today is a booking↔hotel thread; new kinds (e.g. SUPPORT) can
// be added later without another migration touching this field.
enum ConversationKind {
  HOTEL_BOOKING
}

// One thread per (booking, hotel) pair — a multi-city package booking can
// touch several hotels owned by different hosts, so scoping by booking alone
// would leak one owner's messages to another.
model conversation {
  id         Int                    @id @default(autoincrement())
  kind       ConversationKind       @default(HOTEL_BOOKING)
  booking_id String
  hotel_id   Int
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt
  booking    Booking                @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  hotel      hotels                 @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  messages   conversation_message[]

  @@unique([booking_id, hotel_id])
  @@index([hotel_id])
}

model conversation_message {
  id              Int                @id @default(autoincrement())
  conversation_id Int
  sender          ConversationSender
  sender_id       String? // flat actor id snapshot (mirrors ActivityLog's userId convention)
  sender_name     String? // display-name snapshot
  body            String
  read_by_host    Boolean            @default(false)
  read_by_guest   Boolean            @default(false)
  attachment_url  String?
  attachment_name String? // original filename
  attachment_type String? // mime type
  attachment_size Int? // bytes
  deleted_at      DateTime?
  deleted_by      String?
  is_deleted      Boolean            @default(false)
  created_at      DateTime           @default(now())
  conversation    conversation       @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([is_deleted])
}

// One review per (booking, hotel) pair — same reasoning as conversation:
// a multi-city package booking can touch several hotels owned by different
// hosts, so a guest reviews each stay separately, not the whole trip at once.
model hotel_review {
  id               Int       @id @default(autoincrement())
  hotel_id         Int
  booking_id       String
  user_id          String
  rating           Int
  comment          String?
  guest_name       String
  images           String[]  @default([])
  host_response    String?
  host_response_at DateTime?
  created_at       DateTime  @default(now())
  hotel            hotels    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  booking          Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@unique([booking_id, hotel_id])
  @@index([hotel_id])
}

model hotel_wishlist {
  id         Int      @id @default(autoincrement())
  hotel_id   Int
  user_id    String
  created_at DateTime @default(now())
  hotel      hotels   @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@unique([user_id, hotel_id])
  @@index([user_id])
}

model hotel_landmark {
  id         Int      @id @default(autoincrement())
  hotel_id   Int
  category   String
  name       String
  distance_m Int
  lat        Decimal? @db.Decimal(10, 7)
  lon        Decimal? @db.Decimal(10, 7)
  created_at DateTime @default(now())
  hotel      hotels   @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
}

model BookingCab {
  id                String            @id @default(cuid())
  bookingId         String
  legNumber         Int
  fromLocation      String
  toLocation        String
  transferDate      DateTime
  cabType           CabType
  cabCount          Int               @default(1)
  capacity          Int
  ratePerCab        Decimal           @db.Decimal(10, 2)
  totalCost         Decimal           @db.Decimal(10, 2)
  isConfirmed       Boolean           @default(false)
  confirmedAt       DateTime?
  confirmedById     String?
  // Pre-travel double-check with the operator — see BookingHotel.reconfirmedAt.
  reconfirmedAt     DateTime?
  reconfirmedById   String?
  reconfirmedByName String?
  driverName        String?
  driverPhone       String?
  vehicleNumber     String?
  vehicleName       String?
  notes             String?
  status            FulfillmentStatus @default(PENDING)
  voucherUrl        String?
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedBy       TeamMember?       @relation(fields: [confirmedById], references: [id])

  @@unique([bookingId, legNumber])
  @@index([bookingId])
  @@map("booking_cabs")
}

model BookingActivity {
  id            String            @id @default(cuid())
  bookingId     String
  dayNumber     Int
  activityId    Int
  variantId     Int?
  name          String
  isPaid        Boolean           @default(false)
  status        FulfillmentStatus @default(PENDING)
  voucherUrl    String?
  confirmedAt   DateTime?
  confirmedById String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, dayNumber, activityId])
  @@index([bookingId])
  @@map("booking_activities")
}

model ReplacementOffer {
  id             String    @id @default(cuid())
  bookingId      String
  kind           String
  day            Int
  activityId     Int?
  options        Json
  status         String    @default("PROPOSED")
  chosenOptionId String?
  proposedById   String
  proposedByName String
  chosenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("replacement_offers")
}

model BookingTraveller {
  id             String        @id @default(cuid())
  bookingId      String
  type           TravellerType
  fullName       String
  age            Int?
  dateOfBirth    DateTime?
  gender         Gender?
  isLead         Boolean       @default(false)
  passportNumber String?
  passportExpiry DateTime?
  nationality    String?
  createdAt      DateTime      @default(now())
  firstName      String?
  lastName       String?
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_travellers")
}

model PaymentInstallment {
  id             String            @id @default(cuid())
  bookingId      String
  type           InstallmentType
  sequence       Int               @default(0)
  amount_paise   Int
  dueDate        DateTime?
  status         InstallmentStatus @default(PENDING)
  paidPaymentId  String?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reminderSentAt DateTime?
  reminderCount  Int               @default(0)
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([bookingId])
  @@index([status])
  @@map("payment_installments")
}

model WebhookEvent {
  id          String         @id @default(cuid())
  gateway     PaymentGateway
  eventId     String
  eventType   String?
  payload     Json
  signature   String?
  status      WebhookStatus  @default(RECEIVED)
  error       String?
  paymentId   String?
  bookingId   String?
  receivedAt  DateTime       @default(now())
  processedAt DateTime?

  @@unique([gateway, eventId])
  @@index([status])
  @@index([paymentId])
  @@map("webhook_events")
}

model PackageBookingHotel {
  id           String   @id @default(cuid())
  bookingId    String
  hotelId      Int
  stayType     String?
  checkingDate DateTime
  checkoutDate DateTime
  pax          Int      @default(1)
  rooms        Int      @default(1)
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel        hotels   @relation(fields: [hotelId], references: [id])

  @@index([bookingId])
  @@map("package_booking_hotel")
}

model BookingTimeline {
  id              String         @id @default(cuid())
  bookingId       String
  action          TimelineAction
  fromStatus      BookingStatus?
  toStatus        BookingStatus?
  note            String?
  performedById   String
  performedByName String
  departmentId    String?
  createdAt       DateTime       @default(now())
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  department      Department?    @relation("TimelineDepartment", fields: [departmentId], references: [id])
  performedBy     TeamMember     @relation("TimelinePerformedBy", fields: [performedById], references: [id])

  @@index([bookingId])
  @@index([performedById])
  @@map("booking_timeline")
}

model Payment {
  id               String         @id @default(cuid())
  bookingId        String
  userId           String
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  gateway          PaymentGateway
  method           PaymentMethod?
  status           PaymentStatus  @default(PENDING)
  gatewayOrderId   String?        @unique
  gatewayPaymentId String?        @unique
  gatewaySignature String?
  refundId         String?
  refundAmount     Decimal?       @db.Decimal(10, 2)
  refundedAt       DateTime?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  amount_paise     Int            @default(0)
  idempotencyKey   String?        @unique
  rawResponse      Json?
  webhookEventId   String?
  purpose          PaymentPurpose @default(INITIAL)
  booking          Booking        @relation(fields: [bookingId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@index([webhookEventId])
  @@map("payments")
}

model Location {
  id               BigInt            @id @default(autoincrement())
  parent_id        BigInt?
  type             LocationType
  name             String
  official_name    String?
  slug             String            @unique
  short_code       String?
  iso_code         String?
  latitude         Decimal?          @db.Decimal(10, 7)
  longitude        Decimal?          @db.Decimal(10, 7)
  elevation_meters Int?
  timezone         String?
  population       Int?
  seo_title        String?
  seo_description  String?
  description      String?
  hero_image       String?
  is_featured      Boolean           @default(false)
  is_popular       Boolean           @default(false)
  is_searchable    Boolean           @default(true)
  is_active        Boolean           @default(true)
  country_id       BigInt?
  state_id         BigInt?
  city_id          BigInt?
  geonames_id      Int?
  osm_id           String?
  mapbox_id        String?
  metadata         Json?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  activities       activities[]
  hotels           hotels[]
  city             Location?         @relation("CityRelation", fields: [city_id], references: [id])
  city_children    Location[]        @relation("CityRelation")
  country          Location?         @relation("CountryRelation", fields: [country_id], references: [id])
  country_children Location[]        @relation("CountryRelation")
  parent           Location?         @relation("LocationHierarchy", fields: [parent_id], references: [id])
  children         Location[]        @relation("LocationHierarchy")
  state            Location?         @relation("StateRelation", fields: [state_id], references: [id])
  state_children   Location[]        @relation("StateRelation")
  route_stops      route_stops[]
  drop_routes      transfer_routes[] @relation("drop_routes")
  pickup_routes    transfer_routes[] @relation("pickup_routes")
  cabPricings      cab_pricing[]     @relation("CabPricingLocation")
  permits          permits[]

  @@index([type])
  @@index([parent_id])
  @@index([country_id])
  @@index([state_id])
  @@index([city_id])
  @@index([latitude, longitude])
  @@index([is_active])
  @@index([is_searchable])
  @@index([name])
  @@index([slug])
  @@map("locations")
}

model Department {
  id              String            @id @default(cuid())
  name            String            @unique @db.VarChar(100)
  description     String?           @db.VarChar(500)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  timelineEntries BookingTimeline[] @relation("TimelineDepartment")
  currentBookings Booking[]         @relation("BookingCurrentDept")
  members         TeamMember[]

  @@map("departments")
}

model TeamRole {
  id          String       @id @default(cuid())
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(500)
  permissions Json         @default("[]")
  pageAccess  Json         @default("[]")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TeamMember[]

  @@map("team_roles")
}

model TeamMember {
  id                     String            @id @default(cuid())
  name                   String            @db.VarChar(255)
  email                  String            @unique
  password               String?
  departmentId           String?
  teamRoleId             String?
  isActive               Boolean           @default(true)
